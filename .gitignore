# Local configuration and secrets
.env
.env.*
!.env.example
!.env.production.example

# Python environments and caches
.venv/
# Open Interpreter's own environment. Deliberately separate from .venv: it needs Python
# 3.11 while the product uses 3.12, and it pulls in litellm, selenium and matplotlib,
# which would change what the release gate's `pip check` and check_dependency_lock.py
# see. Rebuild it with tools/oi/bootstrap.ps1 or tools/oi/bootstrap.sh.
.oi-venv/
venv/
env/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.chatbot_eval_cache.sqlite3
chatbot_eval_runs/
# Supplied evaluator distribution bundle. The integrated, maintained package
# lives at src/hm_chatbot_eval.
HilalMarkets_Chatbot_AI_Evaluator/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

