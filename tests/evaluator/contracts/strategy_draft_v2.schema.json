      },
      "title": "ApprovalBindingV2",
      "type": "object"
    },
    "Comparator": {
      "enum": [
        "gt",
        "gte",
        "lt",
        "lte",
        "eq",
        "crosses_above",
        "crosses_below",
        "is_true",
        "is_false"
      ],
      "title": "Comparator",
      "type": "string"
    },
    "ConditionNodeType": {
      "enum": [
        "condition",
        "and",
        "or",
        "not"
      ],
      "title": "ConditionNodeType",
      "type": "string"
    },
