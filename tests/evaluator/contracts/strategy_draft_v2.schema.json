        "reference_definition": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Definition"
        },
        "reference_timeframe": {
          "anyOf": [
            {
              "pattern": "^(1|3|5|15|30)m$|^(1|2|4|6|8|12)h$|^1d$",
              "type": "string"
