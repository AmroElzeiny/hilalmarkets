          "default": null,
          "title": "Schema Hash"
        },
        "screening_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewedScreeningEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "user_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Id"
        }
      },
      "title": "ApprovalBindingV2",
      "type": "object"
    },
    "Comparator": {
      "enum": [
