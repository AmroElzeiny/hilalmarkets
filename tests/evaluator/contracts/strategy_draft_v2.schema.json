        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "node_type": {
          "$ref": "#/$defs/ConditionNodeType"
        },
        "operands": {
          "items": {
            "$ref": "#/$defs/OperandV2"
          },
          "maxItems": 12,
          "title": "Operands",
          "type": "array"
        },
        "operator": {
          "anyOf": [
            {
              "$ref": "#/$defs/Comparator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
