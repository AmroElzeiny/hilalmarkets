BYBIT_API_KEY=
BYBIT_API_SECRET=

# AI interpretation.
AI_INTERPRETER_PROVIDER=openai
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
# Evaluator controls and LLM fault injection are test-environment only.
AI_SETUP_EVALUATOR_ENABLED=false
AI_SETUP_EVALUATOR_FAULTS_ENABLED=false
AI_SETUP_EVALUATOR_TARGET_VERSIONS={}
# The authenticated Setup Chat path. Startup validation rejects false: there is no
# other writable route to fall back to.
SETUP_CHAT_LAUNCH_V2_ENABLED=true
SETUP_CHAT_EMERGENCY_DISABLED=false
SETUP_CHAT_PRIVATE_BETA_USER_IDS=[]
SETUP_CHAT_LEGACY_TEST_COMPAT_ENABLED=false

# --- Setup Agent bounds. These govern Setup Chat traffic; AI_AGENT_* below does not. ---
SETUP_AGENT_PLANNER_MAX_OUTPUT_TOKENS=8000
SETUP_AGENT_COMPOSER_MAX_OUTPUT_TOKENS=1600
SETUP_AGENT_PLANNER_TIMEOUT_SECONDS=60
SETUP_AGENT_COMPOSER_TIMEOUT_SECONDS=10
SETUP_AGENT_SIMPLE_SERVICE_TIER=default
SETUP_AGENT_COMPLEX_SERVICE_TIER=default
SETUP_AGENT_MAX_ESTIMATED_COST_USD_PER_TURN=0.10
SETUP_AGENT_MAX_ESTIMATED_COST_USD_PER_USER_DAY=2.00
SETUP_AGENT_CIRCUIT_BREAKER_FAILURES=5
SETUP_AGENT_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
SETUP_PROVIDER_PREFLIGHT_TTL_SECONDS=300
SETUP_SCREENING_RESOLUTION_TTL_SECONDS=300
SETUP_METHODOLOGY_VERSION_TTL_SECONDS=300
SETUP_APPROVED_WATCHLIST_TTL_SECONDS=300

TEST_AI_MODEL=gpt-5.6-luna
TEST_AI_REASONING=none
TEST_AI_SERVICE_TIER=flex
# The evaluator prices the target the way the app actually runs it. Placeholder
# rates: replace with the published gpt-5.6-luna price when it is known.
TARGET_MODEL=gpt-5.6-luna
EVAL_MODEL_PRICING_USD_PER_MILLION={"gpt-5.6-luna":{"standard":{"input":0.25,"cached_input":0.025,"output":2.0},"flex":{"input":0.125,"cached_input":0.0125,"output":1.0}}}
JUDGE_MAX_OUTPUT_TOKENS=4000
TEST_AI_INPUT_USD_PER_1M=0.125
TEST_AI_CACHED_INPUT_USD_PER_1M=0.0125
TEST_AI_OUTPUT_USD_PER_1M=1
EVAL_OUTPUT_DIR=chatbot_eval_runs
EVAL_CACHE_DB=.chatbot_eval_cache.sqlite3
EVAL_BUDGET_USD=2.5
EVAL_BUDGET_PROFILE_MAX_USD=2.5
EVAL_MAX_CONCURRENCY=2
EVAL_DEFAULT_TESTS_PER_TOPIC=24
EVAL_READINESS_ATTEMPTS=2
EVAL_CIRCUIT_BREAKER_FAILURES=2
TARGET_STRATEGY_SCHEMA_FILE=tests/evaluator/contracts/strategy_definition.schema.json
TARGET_SCHEMA_FILE=tests/evaluator/contracts/setup_chat_evaluation_contract.schema.json
TARGET_FIELD_MAP_FILE=tests/evaluator/contracts/field_map.json
TARGET_BACKEND_ADAPTER=hilalmarkets
TARGET_BACKEND_BASE_URL=http://127.0.0.1:8000
TARGET_BACKEND_SESSION_PATH=/api/v1/dashboard/setup-chat/sessions
TARGET_BACKEND_MESSAGE_PATH_TEMPLATE=/api/v1/dashboard/setup-chat/sessions/{chat_id}/messages
TARGET_BACKEND_LOGIN_PATH=/signin
TARGET_BACKEND_EMAIL=
TARGET_BACKEND_PASSWORD=
TARGET_SESSION_COOKIE=
TARGET_UI_URL=http://127.0.0.1:8000/dashboard/strategies/new
TARGET_UI_EMAIL=
TARGET_UI_PASSWORD=
TARGET_UI_HEADLESS=true
TARGET_VARIANTS_JSON=[]
OPENAI_TIMEOUT_SECONDS=20
OPENAI_EXPLANATION_ENABLED=true
# Stronger routing is reserved for complex language; deterministic validation remains unchanged.
AI_SETUP_SIMPLE_MODEL=gpt-5.6-luna
AI_SETUP_SIMPLE_REASONING_EFFORT=low
AI_SETUP_COMPLEX_MODEL=gpt-5.6-luna
AI_SETUP_COMPLEX_REASONING_EFFORT=low
AI_SETUP_COMPLEX_CONDITION_THRESHOLD=4
AI_SETUP_REPEATED_CORRECTION_THRESHOLD=2
AI_SETUP_LOW_CAPABILITY_CONFIDENCE=0.72
# Bounded Agent Control is the OLD general coordinator and has no authority over
# authenticated Setup Chat. It is not a Setup Chat rollback switch: turning it off
# changes nothing on that path, because the Setup Agent owns it. Off in production.
#
# To roll Setup Chat back, there is no flag — the agent path is the only writable route.
# Roll back the deployment.
AI_AGENT_CONTROL_ENABLED=false
AI_AGENT_SHADOW_MODE=false
AI_AGENT_ROLLOUT_PERCENT=0
AI_AGENT_MAX_STEPS=4
AI_AGENT_MAX_TOOL_CALLS_PER_TURN=4
AI_AGENT_MAX_REPEATED_CALLS=1
AI_AGENT_TIMEOUT_SECONDS=45
AI_AGENT_TOOL_TIMEOUT_SECONDS=30
AI_AGENT_MAX_OUTPUT_TOKENS=1800
AI_AGENT_MAX_ESTIMATED_COST_USD_PER_TURN=0.02
AI_AGENT_PARALLEL_TOOL_CALLS=false
AI_SEMANTIC_FALLBACK_ENABLED=false
AI_CAPABILITY_RERANKER_ENABLED=true
AI_CAPABILITY_RERANKER_MIN_CONFIDENCE=0.86
AI_CAPABILITY_RERANKER_CANDIDATE_LIMIT=24
CAPABILITY_EMBEDDINGS_ENABLED=true
CAPABILITY_EMBEDDING_MODEL=text-embedding-3-small
CAPABILITY_EMBEDDING_DIMENSIONS=256
CAPABILITY_EXTENSION_ENABLED=true
CAPABILITY_EXTENSION_DRAFT_MODEL=gpt-5.6-luna
CAPABILITY_EXTENSION_DRAFT_REASONING_EFFORT=low
CAPABILITY_EXTENSION_IMPLEMENTATION_MODEL=gpt-5.6-luna
CAPABILITY_EXTENSION_REVIEW_MODEL=gpt-5.6-luna
CAPABILITY_EXTENSION_REPAIR_SERVICE_TIER=flex
CAPABILITY_EXTENSION_AI_MAX_ATTEMPTS=3
CAPABILITY_EXTENSION_FLEX_TIMEOUT_SECONDS=900
CAPABILITY_EXTENSION_PREFLIGHT_EXCHANGE=binance
CAPABILITY_EXTENSION_PREFLIGHT_MAX_SYMBOLS=200
CAPABILITY_EXTENSION_PREFLIGHT_CONCURRENCY=8
CAPABILITY_EXTENSION_CANDLE_LIMIT=500
CAPABILITY_EXTENSION_MAX_HISTORY_CANDLES=25000
CAPABILITY_EXTENSION_MARKET_TEST_CANDLE_BUDGET=300000
CAPABILITY_EXTENSION_EMPTY_SCAN_THRESHOLD=5
CAPABILITY_EXTENSION_NO_NOTIFICATION_THRESHOLD=5
CAPABILITY_EXTENSION_MIN_CANDIDATE_RATE=0.0005
CAPABILITY_EXTENSION_MAX_CANDIDATE_RATE=0.35
CAPABILITY_EXTENSION_CERTIFICATION_SCORE=85
CAPABILITY_EXTENSION_DAILY_LIMIT=3
# USD per one million tokens. Confirm current official pricing when changing models.
# The gpt-5.6-luna rates are a placeholder until its published price is confirmed.
OPENAI_MODEL_PRICING_USD_PER_MILLION={"gpt-5.4-nano":{"input":0.2,"cached_input":0.02,"output":1.25},"gpt-5.4-mini":{"input":0.75,"cached_input":0.075,"output":4.5},"gpt-5-mini":{"input":0.25,"cached_input":0.025,"output":2.0},"gpt-5-nano":{"input":0.05,"cached_input":0.005,"output":0.4},"gpt-5.6-luna":{"input":0.25,"cached_input":0.025,"output":2.0}}
OPENAI_FAST_MODEL_PRICING_USD_PER_MILLION={"gpt-5.4-mini":{"input":1.5,"cached_input":0.15,"output":9.0},"gpt-5-mini":{"input":0.45,"cached_input":0.045,"output":3.6},"gpt-5.6-luna":{"input":0.45,"cached_input":0.045,"output":3.6}}

# Telegram.
TELEGRAM_ENABLED=true
TELEGRAM_ADAPTER=http
TELEGRAM_BOT_USERNAME=trace_edge_bot
TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_TELEGRAM_WEBHOOK_SECRET
TELEGRAM_POLLING_ENABLED=true
TELEGRAM_POLLING_CLEAR_WEBHOOK=true
SUPPORT_TELEGRAM_USERNAME=REPLACE_WITH_SUPPORT_USERNAME
ADMIN_NOTIFY_TELEGRAM_USER_ID=

# Official Meta WhatsApp Cloud API. Leave disabled until the production WABA,
# registered business phone, signed webhook, token, and templates are verified.
WHATSAPP_ENABLED=false
WHATSAPP_ADAPTER=none
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_BUSINESS_PHONE_E164=
WHATSAPP_DEFAULT_LANGUAGE=en_US
WHATSAPP_HTTP_TIMEOUT_SECONDS=15
WHATSAPP_MAX_DELIVERY_ATTEMPTS=5
WHATSAPP_OPPORTUNITY_ALERTS_ENABLED=false
# JSON map of Meta-approved template names. Required production keys:
# connection_confirmation, connection_test, account_notice, trial_update,
# subscription_update, compliance_change, evidence_update, watchlist_paused,
# integration_failure, lifecycle_update, and confirmed_research_event when
# opportunity alerts are enabled. See docs/WHATSAPP_CLOUD_API_RUNBOOK.md.
WHATSAPP_TEMPLATE_NAMES={}
WHATSAPP_OPT_IN_VERSION=2026-07
WHATSAPP_MARK_INBOUND_READ=true
WHATSAPP_WEBHOOK_RECEIPT_RETENTION_DAYS=30

# Enable after production provider credentials, signed webhooks, and all exact
# product mappings have passed the sandbox and controlled production checks.
BILLING_ENABLED=false
BILLING_PROVIDER=static
BILLING_CARD_PROVIDER=disabled
BILLING_CRYPTO_PROVIDER=disabled
BILLING_CHECKOUT_TTL_MINUTES=30
BILLING_TERMS_VERSION=2026-07
BILLING_PAYMENT_AMOUNT_TOLERANCE_PERCENT=0
BILLING_ALLOW_OVERPAYMENT=false
PAYMENT_EMAIL_MAX_ATTEMPTS=5
PAYMENT_EMAIL_RETRY_MINUTES=15
BILLING_WEBHOOK_SECRET=
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
# Map exact production products only after verifying price, currency, billing
# period, and the seven-day trial setting in Creem. Internal trader_* keys map
# to the customer-facing Monitor plan.
CREEM_PRODUCT_IDS={}
CREEM_API_BASE=https://api.creem.io
CREEM_TIMEOUT_SECONDS=20
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io
NOWPAY_EMAIL=
NOWPAY_PASSWORD=

# Deployed request limits require Redis and fail closed when it is unavailable.
API_RATE_LIMITING_ENABLED=true
API_RATE_LIMIT_FAIL_CLOSED=true
API_RATE_LIMITS={"authentication":{"limit":10,"window_seconds":900},"ai_chat":{"limit":30,"window_seconds":60},"market_check":{"limit":20,"window_seconds":60},"checkout":{"limit":5,"window_seconds":300},"portal":{"limit":10,"window_seconds":300},"support":{"limit":5,"window_seconds":3600},"passport_report":{"limit":5,"window_seconds":3600},"telegram_test":{"limit":5,"window_seconds":300},"whatsapp_test":{"limit":5,"window_seconds":300},"public_chat":{"limit":20,"window_seconds":60},"public_inquiry":{"limit":5,"window_seconds":3600},"public_waitlist":{"limit":5,"window_seconds":3600},"public_contact":{"limit":5,"window_seconds":3600},"site_analytics":{"limit":120,"window_seconds":60},"admin_mutation":{"limit":30,"window_seconds":60}}

# Email login/support. Use a production SMTP account before enabling.
# Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=2587, SMTP_USERNAME=resend,
# SMTP_PASSWORD=<Resend API key>, SMTP_USE_TLS=true, SMTP_USE_SSL=false.
EMAIL_ADAPTER=smtp
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM_EMAIL=no-reply@hilalmarkets.com
# The name a person sees in their inbox, so it is prose and follows the brand rule:
# "Hilal Markets" with a space (`brand guide.md` section 4). Written without one, every
# email the product sends breaks the rule in the most visible place there is.
SMTP_FROM_NAME=Hilal Markets
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SUPPORT_EMAIL=support@example.com
# First-party visit counting for the public site, read on the System Brain Stats page.
# No cookie, no stored address; independent of the cookie banner.
SITE_VISIT_MEASUREMENT_ENABLED=true
PUBLIC_CHAT_ENABLED=true
PUBLIC_CHAT_AI_ENABLED=true
PUBLIC_CHAT_INQUIRY_EMAIL=office@hilalmarkets.com
PUBLIC_FORMS_ENABLED=true

# --- Hilal, the assistant inside the dashboard -------------------------------
# A different assistant from the public site's support chat. This one answers a
# signed-in customer about listings, Passports, screening standards, reports and
# their plan. It never builds a strategy and never gives financial advice.
HILAL_CHAT_ENABLED=true
HILAL_CHAT_AI_MODEL=gpt-5.6-luna
HILAL_CHAT_AI_REASONING_EFFORT=low
HILAL_CHAT_AI_TIMEOUT_SECONDS=30
HILAL_CHAT_AI_MAX_OUTPUT_TOKENS=900
HILAL_CHAT_AI_MAX_ESTIMATED_COST_USD_PER_TURN=0.02
HILAL_CHAT_AI_PROVIDER_ATTEMPTS=2
HILAL_CHAT_AI_CIRCUIT_FAILURE_THRESHOLD=5
HILAL_CHAT_AI_CIRCUIT_RESET_SECONDS=60
HILAL_CHAT_AI_MAX_HISTORY_MESSAGES=16
HILAL_CHAT_MESSAGE_MAX_LENGTH=800
HILAL_CHAT_COMMENT_MAX_LENGTH=2000
# What one person may spend on Hilal per 24-hour cycle. The cycle is the UTC day,
# so it resets at 00:00 UTC. A paying subscriber gets the multiplier below.
HILAL_CHAT_FREE_DAILY_USD=0.10
HILAL_CHAT_PAID_DAILY_MULTIPLIER=5
HILAL_CHAT_MAX_EVIDENCE_ASSETS=24
HILAL_CHAT_RETENTION_DAYS=365
# The emergency brake: waitlist instead of plans and account entry. See .env.example
# for exactly what it turns off.
#
# The product has launched, so it is false. It remains the ceiling over LAUNCH_STAGE:
# setting it back to true pulls the public site back to the waitlist immediately,
# without a deploy, whatever the stage below says.
PUBLIC_WAITLIST_MODE=false
# The launch stage. The product is open to the public: pricing, plan comparison,
# checkout and account entry are all advertised. Startup refuses this stage if the
# deployment cannot deliver it — checkout advertised with billing switched off, for
# example — so a misconfigured production box fails loudly instead of selling nothing.
LAUNCH_STAGE=public_launch
# --- Durable operational measurements ---------------------------------------
# Production keeps three days of history and folds each window into one row after
# six hours. Retention must stay longer than the rollup age, and startup refuses to
# boot if it is not: rows would be deleted before they were ever folded together.
OBSERVABILITY_WINDOW_SECONDS=300
OBSERVABILITY_FLUSH_INTERVAL_SECONDS=60
OBSERVABILITY_ROLLUP_AFTER_HOURS=6
OBSERVABILITY_RETENTION_HOURS=72
# --- Where a page-worthy alert actually goes ---------------------------------
# Empty here on purpose: a chat id and an operations mailbox are deployment
# secrets and do not belong in a committed example. Empty is the safe value, not
# the working one — while these are unset a page is written to the operational
# issue queue and the delivery row says plainly that it could not be sent. Nothing
# is lost, but nobody is woken. Set both before relying on paging.
OPERATIONAL_ALERT_TELEGRAM_CHAT_ID=
OPERATIONAL_ALERT_EMAIL=
OPERATIONAL_ALERT_REPEAT_MINUTES=30
OPERATIONAL_ALERT_MAX_ATTEMPTS=5
CONTACT_FORM_SENDER_EMAIL=office@hilalmarkets.com
CONTACT_FORM_RECIPIENT_EMAIL=office@hilalmarkets.com
# How many support messages are accepted, and from whom.
#
# One rule for both doors: the public /contact form and the dashboard's support form.
# Both count from the same ledger through services/support_intake.py, so two messages
# per email means two across the whole product rather than two per form.
#
# The first two are what one person may send. The third is the flood ceiling for
# everybody together, which is what stops a crowd of fresh addresses doing what one
# address cannot. Startup refuses a per-person limit above the ceiling.
SUPPORT_INTAKE_MAX_PER_EMAIL=2
SUPPORT_INTAKE_MAX_PER_CLIENT=2
SUPPORT_INTAKE_MAX_PER_HOUR=20
# The period all three are counted over, in seconds. 3600 is one hour.
SUPPORT_INTAKE_WINDOW_SECONDS=3600
PUBLIC_FORM_EMAIL_MAX_ATTEMPTS=5
PUBLIC_FORM_EMAIL_RETRY_MINUTES=15
PUBLIC_FORM_DELIVERY_CLAIM_TIMEOUT_MINUTES=10
# Server-only Google Apps Script Web App endpoint. Never use a public Sheet URL here.
WAITLIST_GOOGLE_SHEETS_ENABLED=false
WAITLIST_GOOGLE_SHEETS_WEBHOOK_URL=
WAITLIST_GOOGLE_SHEETS_WEBHOOK_SECRET=
WAITLIST_GOOGLE_SHEETS_TIMEOUT_SECONDS=15
WAITLIST_GOOGLE_SHEETS_MAX_ATTEMPTS=8
WAITLIST_GOOGLE_SHEETS_RETRY_MINUTES=15
WAITLIST_TRUST_CLOUDFLARE_COUNTRY_HEADER=true
PUBLIC_CHAT_PROFILE_VERSION=1
PUBLIC_CHAT_MESSAGE_MAX_LENGTH=800
PUBLIC_CHAT_INQUIRY_MAX_LENGTH=4000
PUBLIC_CHAT_ANSWER_AUDIT_RETENTION_DAYS=90
PUBLIC_CHAT_INQUIRY_RETENTION_DAYS=365
PUBLIC_CHAT_EMAIL_MAX_ATTEMPTS=5
PUBLIC_CHAT_EMAIL_RETRY_MINUTES=15
PUBLIC_CHAT_EMAIL_CLAIM_TIMEOUT_MINUTES=10
PUBLIC_CHAT_AI_MODEL=gpt-5.6-luna
PUBLIC_CHAT_AI_REASONING_EFFORT=low
PUBLIC_CHAT_AI_TIMEOUT_SECONDS=30
PUBLIC_CHAT_AI_MAX_OUTPUT_TOKENS=1200
PUBLIC_CHAT_AI_MAX_ESTIMATED_COST_USD_PER_TURN=0.015
PUBLIC_CHAT_AI_MIN_CONFIDENCE=0.55
PUBLIC_CHAT_AI_MAX_HISTORY_MESSAGES=12
PUBLIC_CHAT_AI_MAX_READ_TOOLS=3
PUBLIC_CHAT_SESSION_MAX_TURNS=40
PUBLIC_CHAT_AI_PROVIDER_ATTEMPTS=2
PUBLIC_CHAT_AI_CIRCUIT_FAILURE_THRESHOLD=5
PUBLIC_CHAT_AI_CIRCUIT_RESET_SECONDS=60
PUBLIC_CHAT_SESSION_RETENTION_DAYS=30
PUBLIC_CHAT_NOTION_ENABLED=true
PUBLIC_CHAT_NOTION_ROOT=./Notion
PUBLIC_CHAT_NOTION_MAX_DOCUMENTS=6
PUBLIC_CHAT_NOTION_MAX_CHARACTERS=12000
PUBLIC_CHAT_NOTION_MAX_FILE_BYTES=262144

# Protected Capability Coverage Console: https://app.hilalmarkets.com/system-brain
# Generate a PBKDF2 hash with core.security.hash_password and never store plaintext here.
SYSTEM_BRAIN_ADMIN_USERNAME=contact@trace-edge.com
SYSTEM_BRAIN_ADMIN_EMAILS=
SYSTEM_BRAIN_ADMIN_PASSWORD_HASH=REPLACE_WITH_PBKDF2_HASH
SYSTEM_BRAIN_OTP_TTL_MINUTES=10
SYSTEM_BRAIN_OTP_MAX_ATTEMPTS=5
SYSTEM_BRAIN_SESSION_HOURS=8
SYSTEM_BRAIN_LOGIN_ATTEMPTS_PER_15_MINUTES=5
# Keep the origin inaccessible directly. Cloudflare Access supplies these headers;
# HilalMarkets still requires its own password, email OTP, database session, and CSRF checks.
SYSTEM_BRAIN_CLOUDFLARE_ACCESS_REQUIRED=true
SYSTEM_BRAIN_AI_ENABLED=true
SYSTEM_BRAIN_AI_MODEL=gpt-5.6-luna
SYSTEM_BRAIN_AI_REASONING_EFFORT=low
SYSTEM_BRAIN_AI_TIMEOUT_SECONDS=30
SYSTEM_BRAIN_AI_MAX_OUTPUT_TOKENS=900
SYSTEM_BRAIN_AI_MAX_CONTEXT_CHARACTERS=24000
SYSTEM_BRAIN_AI_MAX_ESTIMATED_COST_USD_PER_TURN=0.02
SYSTEM_BRAIN_AGENT_MAX_STEPS=6
SYSTEM_BRAIN_AGENT_MAX_TOOL_CALLS=8
SYSTEM_BRAIN_AGENT_MAX_REPEATED_CALLS=1
SYSTEM_BRAIN_AGENT_TOOL_TIMEOUT_SECONDS=10
SYSTEM_BRAIN_AGENT_TURN_TIMEOUT_SECONDS=50
SYSTEM_BRAIN_AGENT_MAX_HISTORY_MESSAGES=16
SYSTEM_BRAIN_AGENT_EVIDENCE_TTL_SECONDS=300
SYSTEM_BRAIN_AGENT_MAX_TURNS_PER_HOUR=30
SYSTEM_BRAIN_AGENT_MAX_COST_USD_PER_DAY=5.0
SYSTEM_BRAIN_AGENT_MAX_TOOL_PAYLOAD_CHARACTERS=24000

# Optional provider-backed concepts. Keep disabled unless configured and tested.
# Bybit spot data is supplied by BYBIT_* above through the exchange market-data
# provider. It can support exchange candles, tickers, 24h volume/change, breadth,
# rankings, and spot order-book context. It cannot truthfully provide total crypto
# market cap, BTC dominance, TOTAL2/TOTAL3, or token categories, so keep the
# CRYPTO_INDEX_* and TOKEN_CATEGORY_* placeholders empty unless you configure a
# real global-index/category provider.
COINGECKO_ENABLED=true
COINGECKO_API_BASE=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
COINGECKO_PLAN=none
MARKET_METADATA_API_URL=
MARKET_METADATA_API_KEY=
ALTERNATIVE_ME_ENABLED=false
ALTERNATIVE_ME_API_BASE=https://api.alternative.me
CRYPTO_INDEX_API_URL=
CRYPTO_INDEX_API_KEY=
FRED_ENABLED=false
FRED_API_BASE=https://api.stlouisfed.org/fred
FRED_API_KEY=
MACRO_MARKET_API_URL=
MACRO_MARKET_API_KEY=
EVENT_FEED_API_URL=
EVENT_FEED_API_KEY=
TOKEN_CATEGORY_API_URL=
TOKEN_CATEGORY_API_KEY=
# Derivatives are disabled for the spot-only product. Keep these empty.
DERIVATIVES_CONTEXT_API_URL=
DERIVATIVES_CONTEXT_API_KEY=

# Product/runtime limits.
TRIAL_DAYS=7
TRIAL_ALERTS_PER_CYCLE=350
DEFAULT_NEAR_MISS_THRESHOLD=70
DEFAULT_ALERT_COOLDOWN_SECONDS=900
DASHBOARD_EXPORT_DIRECTORY=/app/exports
CHART_LIBRARY_CDN_URL=/static/vendor/lightweight-charts.standalone.production.js

# --- Setup Chat surface switches and bounds ----------------------------------
# One switch per surface, on purpose. When the planner is failing, turn off the
# planner rather than the product. With the Builder on, a person can still author a
# complete Watchlist with every AI part switched off.
SETUP_FREE_TEXT_ENABLED=true
SETUP_PLANNER_ENABLED=true
SETUP_COMPOSER_ENABLED=true
SETUP_BUILDER_ENABLED=true
SETUP_SCANNER_ENABLED=true
SETUP_MONITOR_ENABLED=true
SETUP_BUILDER_USER_IDS=
SETUP_AI_LANGUAGES=
SETUP_TURN_DEADLINE_SECONDS=45.0
SETUP_PREFLIGHT_SYMBOL_CAP=25
SETUP_PREFLIGHT_MAX_CONCURRENCY=4
# Crash recovery for a turn that died holding its session. Off means a crashed turn
# locks the session and the person cannot send anything.
SETUP_CHAT_RECOVERY_DISABLED=false
SETUP_CHAT_RECOVERY_INTERVAL_SECONDS=60
# Forbidden in staging and production; startup refuses it. A permanently optional
# question identity lets a message written against a screen that has moved on land on
# whatever field is current now.
SETUP_CHAT_ALLOW_MISSING_ANSWER_IDENTITY=false

# --- Runtime rollout ceilings -------------------------------------------------
# Hard ceilings a runtime control can never switch back on. Comma separated.
AI_FEATURES_DISABLED=
BUILDER_CAPABILITIES_DISABLED=
AI_ROLLOUT_VERSION=0

# --- AI money ceilings --------------------------------------------------------
# Enforced by one authority. A call whose cost cannot be estimated is refused.
AI_BUDGET_PER_TURN_MAX_USD=1.0
AI_BUDGET_USER_DAILY_USD=5.0
AI_BUDGET_USER_MONTHLY_USD=50.0
AI_BUDGET_GLOBAL_DAILY_USD=200.0
AI_BUDGET_GLOBAL_MONTHLY_USD=2000.0
AI_BUDGET_MAX_CONCURRENT_RESERVATIONS=3

# --- Provider reliability -----------------------------------------------------
# Every bound is finite on purpose: an unbounded pool opens a socket per concurrent
# call, and an unbounded wait hangs every caller instead of failing reportably.
PROVIDER_POOL_MAX_CONNECTIONS=40
PROVIDER_POOL_MAX_KEEPALIVE=20
PROVIDER_POOL_KEEPALIVE_SECONDS=30.0
PROVIDER_POOL_TIMEOUT_SECONDS=5.0
PROVIDER_CONNECT_TIMEOUT_SECONDS=5.0
PROVIDER_READ_TIMEOUT_SECONDS=30.0
PROVIDER_WRITE_TIMEOUT_SECONDS=10.0
PROVIDER_MAX_CONCURRENCY=24
PROVIDER_RETRY_MAX_ATTEMPTS=3
PROVIDER_RETRY_BASE_DELAY_SECONDS=0.5
PROVIDER_RETRY_MAX_DELAY_SECONDS=8.0
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_RECOVERY_SECONDS=30.0
PROVIDER_CIRCUIT_SHARE_STATE=true

# --- Capability expression bounds ---------------------------------------------
CAPABILITY_EXTENSION_MAX_EXPRESSION_DEPTH=6
CAPABILITY_EXTENSION_MAX_EXPRESSION_NODES=120

# --- Test-only. Startup REFUSES TO BOOT if this is set here. ------------------
# It must stay empty. With a value, every sign-in code and every System Brain
# second factor becomes the value written here.
AUTH_TEST_FIXED_CODE=
