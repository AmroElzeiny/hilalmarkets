# TraceEdge production environment example.
# Copy to .env.production on the VPS and replace every REPLACE_* value.
# Never commit .env.production.

APP_NAME=TraceEdge
APP_ENV=production
APP_SECRET_KEY=REPLACE_WITH_64_RANDOM_CHARACTERS
PUBLIC_BASE_URL=https://trace-edge.com
APP_BASE_URL=https://app.trace-edge.com
LOG_LEVEL=INFO
ALLOW_MOCK_PROVIDERS=false

# Docker/Postgres.
POSTGRES_DB=market_monitor
POSTGRES_USER=market_monitor
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://market_monitor:REPLACE_WITH_POSTGRES_PASSWORD@db:5432/market_monitor
REDIS_URL=redis://redis:6379/0

# Live scanning.
SCANNING_ENABLED=true
TRACEDGE_MARKET_DATA_MODE=ccxt
TRACEDGE_FIXTURE_MARKET_DATA_ENABLED=false
MARKET_DATA_PROVIDER=ccxt
MARKET_DATA_EXCHANGE=binance
BINANCE_MARKET_DATA_ENABLED=true
BINANCE_ORDER_BOOK_ENABLED=true
BINANCE_DERIVATIVES_ENABLED=false
BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_SPOT_API_BASE=https://api.binance.com
BINANCE_FUTURES_API_BASE=https://fapi.binance.com
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_REST_BASE_URL=https://api.bybit.com
BYBIT_WS_BASE_URL=wss://stream.bybit.com/v5/public/spot
BYBIT_API_KEY=
BYBIT_API_SECRET=

# AI interpretation.
AI_INTERPRETER_PROVIDER=openai
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-nano
OPENAI_REASONING_EFFORT=minimal
OPENAI_TIMEOUT_SECONDS=20
OPENAI_EXPLANATION_ENABLED=true
AI_SEMANTIC_FALLBACK_ENABLED=false

# Telegram.
TELEGRAM_ENABLED=false
TELEGRAM_ADAPTER=none
TELEGRAM_BOT_USERNAME=trace_edge_bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_POLLING_ENABLED=true
TELEGRAM_POLLING_CLEAR_WEBHOOK=true
SUPPORT_TELEGRAM_USERNAME=REPLACE_WITH_SUPPORT_USERNAME
ADMIN_NOTIFY_TELEGRAM_USER_ID=

# Discord.
DISCORD_ENABLED=false
DISCORD_ADAPTER=noop
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_PUBLIC_KEY=

# Billing / NOWPayments.
BILLING_ENABLED=false
BILLING_PROVIDER=static
BILLING_WEBHOOK_SECRET=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io
NOWPAY_EMAIL=
NOWPAY_PASSWORD=

# Email login/support. Use a production SMTP account before enabling.
EMAIL_ADAPTER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SUPPORT_EMAIL=support@trace-edge.com

# Optional provider-backed concepts. Keep disabled unless configured and tested.
COINGECKO_ENABLED=false
COINGECKO_API_BASE=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
COINGECKO_PLAN=none
MARKET_METADATA_API_URL=
MARKET_METADATA_API_KEY=
ALTERNATIVE_ME_ENABLED=false
ALTERNATIVE_ME_API_BASE=https://api.alternative.me
CRYPTO_INDEX_API_URL=
CRYPTO_INDEX_API_KEY=
FRED_ENABLED=false
FRED_API_BASE=https://api.stlouisfed.org/fred
FRED_API_KEY=
MACRO_MARKET_API_URL=
MACRO_MARKET_API_KEY=
EVENT_FEED_API_URL=
EVENT_FEED_API_KEY=
TOKEN_CATEGORY_API_URL=
TOKEN_CATEGORY_API_KEY=
DERIVATIVES_CONTEXT_API_URL=
DERIVATIVES_CONTEXT_API_KEY=

# Product/runtime limits.
TRIAL_DAYS=14
TRIAL_ALERTS_PER_CYCLE=500
DEFAULT_NEAR_MISS_THRESHOLD=70
DEFAULT_ALERT_COOLDOWN_SECONDS=900
DASHBOARD_EXPORT_DIRECTORY=/app/exports
CHART_LIBRARY_CDN_URL=/static/vendor/lightweight-charts.standalone.production.js
