          "kind": "indicator",
          "name": "ema",
          "parameters": {"period": 200, "field": "close"}
        },
        "timeframe": "4h",
        "weight": 2,
        "mandatory": true
      },
      {
        "condition_id": "rsi_pullback",
        "name": "RSI below 35",
        "type": "indicator",
        "indicator": "rsi",
        "operator": "lt",
        "threshold": 35,
        "timeframe": "1h",
        "parameters": {"period": 14, "field": "close"},
        "weight": 1,
        "mandatory": true
      }
    ]
  },
  "entry": {},
  "stop": {"method": "atr", "atr_period": 14, "atr_multiplier": 1.5},
  "targets": [{"label": "T1", "method": "risk_multiple", "value": 2}],
  "risk_rules": {"maximum_stop_percent": 5, "minimum_reward_to_risk": 2},
  "liquidity_rules": {"min_historical_candles": 220},
  "near_miss_rules": {"thresholds": [70, 80, 90]},
