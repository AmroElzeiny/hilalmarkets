{
  "strategy_name": "RSI Pullback Template",
  "market_type": "spot",
  "exchanges": ["binance"],
  "quote_assets": ["USDT"],
  "symbols": [],
  "excluded_symbols": [],
  "primary_timeframe": "1h",
  "higher_timeframes": ["4h"],
  "trigger_mode": "candle_close",
  "logic": {
    "operator": "AND",
    "conditions": [
      {
        "condition_id": "trend_filter",
        "name": "Price above 4h EMA 200",
        "type": "indicator",
