WAITLIST_GOOGLE_SHEETS_MAX_ATTEMPTS=8
WAITLIST_GOOGLE_SHEETS_RETRY_MINUTES=15
WAITLIST_TRUST_CLOUDFLARE_COUNTRY_HEADER=false
PUBLIC_CHAT_PROFILE_VERSION=1
