APP_ENV=development
APP_NAME=HilalMarkets
COMPOSE_PROJECT_NAME=hilalmarkets
POSTGRES_VOLUME_NAME=hilalmarkets_postgres_data
POSTGRES_DB=hilalmarkets
POSTGRES_USER=hilalmarkets
POSTGRES_PASSWORD=
APPLICATION_VERSION=development
API_HOST_PORT=8000
APP_SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql+asyncpg://hilalmarkets:${POSTGRES_PASSWORD}@db:5432/hilalmarkets
DATABASE_POOL_SIZE=5
DATABASE_POOL_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=5.0
DATABASE_POOL_RECYCLE_SECONDS=1800
REDIS_URL=redis://redis:6379/0
PUBLIC_BASE_URL=http://localhost:8000
# The product's own address. Give it a different hostname from PUBLIC_BASE_URL and the
# root of that hostname serves the dashboard rather than the landing page — which is how
# https://app.hilalmarkets.com/ opens the product in the deployed environments. Left the
# same as PUBLIC_BASE_URL here, so a local run still gets the landing page at /.
APP_BASE_URL=http://localhost:8000
# Public metadata. Leave legal identity fields blank until verified by counsel.
PUBLIC_OG_IMAGE_URL=
SITE_LEGAL_NAME=
SITE_COMPANY_ADDRESS=
SITE_GOVERNING_LAW=
SITE_PRIVACY_CONTACT_EMAIL=
SITE_SECURITY_CONTACT_EMAIL=
COOKIE_CONSENT_VERSION=1
GOOGLE_TAG_MANAGER_CONTAINER_ID=
OPTIONAL_ANALYTICS_ENABLED=false
MARKETING_CONSENT_ENABLED=false
# Vite/public analytics settings. IDs are intentionally public; no private keys belong here.
VITE_ANALYTICS_ENABLED=false
VITE_GTM_ID=
# Deprecated: keep empty. Configure the GA4 measurement ID inside GTM.
VITE_GA4_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
VITE_META_PIXEL_ENABLED=false
VITE_X_PIXEL_ID=
VITE_X_PIXEL_ENABLED=false
VITE_SITE_URL=http://localhost:8000
VITE_ANALYTICS_DEBUG=false
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_POLLING_ENABLED=true
TELEGRAM_POLLING_INTERVAL_SECONDS=5
TELEGRAM_POLLING_LIMIT=20
TELEGRAM_POLLING_CLEAR_WEBHOOK=true
BILLING_WEBHOOK_SECRET=
TRIAL_DAYS=7
TRIAL_ALERTS_PER_CYCLE=350
DELIVERY_SETTLEMENT_GRACE_MINUTES=60
# How the API is served. Several workers, each retired after a number of requests, so one
# process being replaced never takes the website down. See .env.production.example.
API_WORKER_PROCESSES=2
API_WORKER_MAX_REQUESTS=20000
API_WORKER_MAX_REQUESTS_JITTER=5000
# What stops one background worker taking the whole server down. These matter in
# production, not on a laptop, but every setting has to appear in both example files -
# see .env.production.example for the arithmetic behind the numbers.
CELERY_WORKER_CONCURRENCY=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=50
CELERY_WORKER_MAX_MEMORY_PER_CHILD_KB=350000
SCAN_JOB_CLAIM_TIMEOUT_SECONDS=900
SCAN_JOB_MAX_ATTEMPTS=3
# How long finished scan history is kept. Scan rows are the fastest-growing thing the
# product writes: one job per monitor per interval, and one result per symbol inside it.
# Deleting a job removes its results and evaluation cycles with it.
#
# What this does NOT delete: the alerts a person received, and the setups that were found.
# Alerts have no retention rule at all and are kept for ever; a setup keeps its row and
# loses only its link to the scan that last touched it (ON DELETE SET NULL).
#
# What it DOES delete is the proof behind them - the per-condition results and near-miss
# snapshots that answer "why did this fire?" (ON DELETE CASCADE from scan_results).
#
# 3 days is a capacity decision taken on 24 August 2026. Measured: 4.22 KB per scan row,
# and 50 monitors on one-minute candles write about 1.58 million rows a day - 6.7 GB a
# day. The server's disk is 40 GB, so 30 days of that would need about 200 GB and fill
# the disk in under a week. At 3 days it is about 20 GB.
SCAN_HISTORY_RETENTION_DAYS=3
# A queued job whose dispatch message is gone can never run and is not pending; past this
# age it is marked failed so retention can reach it. Startup refuses a value that is not
# longer than SCAN_JOB_CLAIM_TIMEOUT_SECONDS, which would expire work still in flight.
SCAN_JOB_ABANDONED_AFTER_HOURS=24
# Rows removed per nightly run, so a first pass over old history is many short
# transactions rather than one long lock on a table the scanner is still writing to.
SCAN_HISTORY_PURGE_BATCH=5000
# How many of those batches one nightly cleanup may do. It exists to give the loop an end,
# not to limit deletion - 200 x 5000 is a million jobs a night. Before it, the cleanup did
# a single batch and stopped, so it could never delete more in a night than it deleted in
# one transaction, however many rows had arrived that day.
SCAN_HISTORY_PURGE_MAX_BATCHES=200
DISCLAIMER_VERSION=2026-06-01
CONTINUATION_TOKEN_TTL_MINUTES=30
PREVIEW_CANDLE_LIMIT=300
DEFAULT_NEAR_MISS_THRESHOLD=70
DEFAULT_ALERT_COOLDOWN_SECONDS=900

# Setup observability. Detailed condition evidence is short-lived; lifecycle events
# and precomputed aggregates remain available for long-term investigation.
OBSERVABILITY_DETAIL_RETENTION_DAYS=14
OBSERVABILITY_LIFECYCLE_RETENTION_DAYS=730
OBSERVABILITY_AGGREGATE_WINDOW_DAYS=30
OBSERVABILITY_MINIMUM_SAMPLE_SIZE=20
OBSERVABILITY_CANDIDATE_STALE_SECONDS=300
OBSERVABILITY_LIVE_POLL_SECONDS=15
OBSERVABILITY_MAX_CANDIDATES_PER_USER=5000
LOG_LEVEL=INFO
ALLOW_MOCK_PROVIDERS=true
SCANNING_ENABLED=false
# Sharia screening is a deployment boundary, not an AI opinion. Keep legacy
# bypass local-only while migrating old test/dev strategies. Deployed scanning
# must enforce an approved, active methodology and must disable the bypass.
SHARIA_SCREENING_ENFORCED=false
SHARIA_ALLOW_LEGACY_UNSCREENED_LOCAL=true
SHARIA_LIVE_QUOTE_CACHE_SECONDS=5.0
SHARIA_DEFAULT_METHODOLOGY_CODE=SC_MALAYSIA_SAC_REFERENCE
SHARIA_UNIVERSE_CACHE_TTL_SECONDS=300
SHARIA_ABNORMAL_EXCLUSION_RATE_THRESHOLD=0.80
SHARIA_ABNORMAL_EXCLUSION_MINIMUM_ASSETS=10
SHARIA_COMPLIANCE_SAFETY_UNDER_REVIEW=true
# Daily non-critical compliance summaries are released at this hour in each user's timezone.
SHARIA_COMPLIANCE_DIGEST_LOCAL_HOUR=8
# Authority evidence governance. Imported SC Malaysia and Fasset records remain
# unpublished until explicit human review and separate publication in System Brain.
SHARIA_ADMIN_TELEGRAM_CHAT_ID=1261328718
SC_MALAYSIA_DIGITAL_ASSETS_URL=https://www.sc.com.my/digital-assets
FASSET_SHARIAH_REPORTS_URL=https://www.fasset.com/shariah-reports
FASSET_MINIMUM_PROFILE_COUNT=100
SHARIA_AI_MODEL=gpt-5.6-luna
SHARIA_AI_REASONING_EFFORT=low
SHARIA_AI_SERVICE_TIER=flex
SHARIA_AI_TIMEOUT_SECONDS=900
SHARIA_AI_MAX_RETRIES=5
SHARIA_AI_ALLOW_STANDARD_FALLBACK=false
SHARIA_REVIEW_REMINDER_HOURS=6
SHARIA_REVIEW_SLA_HOURS=48
# Keep false for the current owner-operated review flow. When true, the publisher
# must be a different governance account from the recorded reviewer.
REQUIRE_SECOND_REVIEWER=false
# How often one coin's Shariah evidence is looked at again: one week.
# One number, read by the authority importers, the research pipeline, the published-source
# monitor and the governance record alike. It is NOT how often the tasks run - beat ticks
# daily and this decides what is due, so a new coin does not wait for a weekly firing.
SHARIA_SOURCE_SCAN_INTERVAL_HOURS=168
SHARIA_SCRAPER_CONCURRENCY=1
SHARIA_SCRAPER_OBEY_ROBOTS=true
SHARIA_SCRAPER_DOWNLOAD_DELAY_SECONDS=1
SHARIA_PILOT_SYMBOLS=BTC,ETH,SOL
SHARIA_PROCESS_REMAINING_IMPORTS=true
SHARIA_IMPORT_PACK_PATH=HilalMarkets_Sharia_Methodology_Import_Pack/HilalMarkets_Sharia_Methodology_Import_Pack
SHARIA_IMPORT_AUTO_PUBLISH=true
SHARIA_IMPORT_REQUIRE_ADMIN_REVIEW=false
SHARIA_IMPORT_METADATA_ONLY_PUBLICATION=true
# How old retained evidence may be, in days, when a reviewer decides an import-pack case.
# A Shariah-governance number: change it with the governance owner, not to move a queue.
SHARIA_PACK_EVIDENCE_MAX_AGE_DAYS=90
SHARIA_IDENTITY_DISCOVERY_BATCH_SIZE=250
# Look for each asset's official news and community pages, and prove they are alive
# before anything treats them as evidence. Turning this off proposes no new links; it
# withdraws nothing already proved.
SHARIA_SOURCE_RESOLUTION_ENABLED=true
# How many assets one sweep may work through. Each costs a few requests to somebody
# else's site, so this stays small and the sweep continues next time.
SHARIA_SOURCE_RESOLUTION_BATCH_SIZE=25
# How long a proved link is trusted before it is fetched again.
SHARIA_SOURCE_RECHECK_DAYS=30
SHARIA_EXTERNAL_RIGHTS_ENFORCEMENT=true
SHARIA_AI_ENRICHMENT_ENABLED=true
SHARIA_AI_ENRICHMENT_OFFICIAL_SOURCES_ONLY=true
SHARIA_AI_ENRICHMENT_STORE_AS_EXTERNAL_REASON=false
TRACEDGE_MARKET_DATA_MODE=ccxt
TRACEDGE_FIXTURE_MARKET_DATA_ENABLED=false
MARKET_DATA_PROVIDER=ccxt
MARKET_DATA_EXCHANGE=binance
