BYBIT_API_SECRET=
BYBIT_REST_BASE_URL=https://api.bybit.com
BYBIT_WS_BASE_URL=wss://stream.bybit.com/v5/public/spot
# Optional public/provider-required data sources. Disabled for beta unless adapter,
