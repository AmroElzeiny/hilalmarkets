# SMTP_PASSWORD=<Resend API key>, SMTP_USE_TLS=true, SMTP_USE_SSL=false.
# Local no-send adapter. Staging/production public chat requires real SMTP.
EMAIL_ADAPTER=memory
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=HilalMarkets
SMTP_USE_TLS=true
SMTP_USE_SSL=false
AUTH_CODE_TTL_MINUTES=10
AUTH_CODE_MAX_ATTEMPTS=5
# Public product assistant. AI responses are grounded in server-owned product
