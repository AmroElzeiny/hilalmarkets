APP_ENV=development
APP_NAME=HilalMarkets
POSTGRES_DB=market_monitor
POSTGRES_USER=market_monitor
POSTGRES_PASSWORD=
APPLICATION_VERSION=development
API_HOST_PORT=8000
APP_SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=sqlite+aiosqlite:///./ai_market_monitor.db
REDIS_URL=redis://localhost:6379/0
PUBLIC_BASE_URL=http://localhost:8000
APP_BASE_URL=http://localhost:8000
# Public metadata. Leave legal identity fields blank until verified by counsel.
PUBLIC_OG_IMAGE_URL=
SITE_LEGAL_NAME=
SITE_COMPANY_ADDRESS=
SITE_GOVERNING_LAW=
SITE_PRIVACY_CONTACT_EMAIL=
SITE_SECURITY_CONTACT_EMAIL=
COOKIE_CONSENT_VERSION=1
GOOGLE_TAG_MANAGER_CONTAINER_ID=
OPTIONAL_ANALYTICS_ENABLED=false
MARKETING_CONSENT_ENABLED=false
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_POLLING_ENABLED=true
TELEGRAM_POLLING_INTERVAL_SECONDS=5
TELEGRAM_POLLING_LIMIT=20
TELEGRAM_POLLING_CLEAR_WEBHOOK=true
BILLING_WEBHOOK_SECRET=
TRIAL_DAYS=14
TRIAL_ALERTS_PER_CYCLE=500
DELIVERY_SETTLEMENT_GRACE_MINUTES=60
SCAN_JOB_CLAIM_TIMEOUT_SECONDS=900
SCAN_JOB_MAX_ATTEMPTS=3
DISCLAIMER_VERSION=2026-06-01
CONTINUATION_TOKEN_TTL_MINUTES=30
PREVIEW_CANDLE_LIMIT=300
DEFAULT_NEAR_MISS_THRESHOLD=70
DEFAULT_ALERT_COOLDOWN_SECONDS=900

# Setup observability. Detailed condition evidence is short-lived; lifecycle events
# and precomputed aggregates remain available for long-term investigation.
OBSERVABILITY_DETAIL_RETENTION_DAYS=14
OBSERVABILITY_LIFECYCLE_RETENTION_DAYS=730
OBSERVABILITY_AGGREGATE_WINDOW_DAYS=30
OBSERVABILITY_MINIMUM_SAMPLE_SIZE=20
OBSERVABILITY_CANDIDATE_STALE_SECONDS=300
OBSERVABILITY_LIVE_POLL_SECONDS=15
OBSERVABILITY_MAX_CANDIDATES_PER_USER=5000
LOG_LEVEL=INFO
ALLOW_MOCK_PROVIDERS=true
SCANNING_ENABLED=false
# Sharia screening is a deployment boundary, not an AI opinion. Keep legacy
# bypass local-only while migrating old test/dev strategies. Deployed scanning
# must enforce an approved, active methodology and must disable the bypass.
SHARIA_SCREENING_ENFORCED=false
SHARIA_ALLOW_LEGACY_UNSCREENED_LOCAL=true
# Development/test display mode only. It is never an executable Sharia ruling.
SHARIA_TEST_MARKET_ENABLED=false
SHARIA_LIVE_QUOTE_CACHE_SECONDS=0.75
SHARIA_DEFAULT_METHODOLOGY_CODE=SC_MALAYSIA_SAC_REFERENCE
SHARIA_UNIVERSE_CACHE_TTL_SECONDS=300
SHARIA_ABNORMAL_EXCLUSION_RATE_THRESHOLD=0.80
SHARIA_ABNORMAL_EXCLUSION_MINIMUM_ASSETS=10
SHARIA_COMPLIANCE_SAFETY_UNDER_REVIEW=true
# Daily non-critical compliance summaries are released at this hour in each user's timezone.
SHARIA_COMPLIANCE_DIGEST_LOCAL_HOUR=8
# SC Malaysia evidence governance. Imported rows remain unpublished until an
# authenticated ADMIN records an approval in System Brain.
SHARIA_ADMIN_TELEGRAM_CHAT_ID=1261328718
SC_MALAYSIA_DIGITAL_ASSETS_URL=https://www.sc.com.my/digital-assets
SHARIA_AI_MODEL=gpt-5.4-nano
SHARIA_AI_REASONING_EFFORT=low
SHARIA_AI_SERVICE_TIER=flex
SHARIA_AI_TIMEOUT_SECONDS=900
SHARIA_AI_MAX_RETRIES=5
SHARIA_AI_ALLOW_STANDARD_FALLBACK=false
SHARIA_REVIEW_REMINDER_HOURS=6
SHARIA_REVIEW_SLA_HOURS=48
# Keep false for the current owner-operated review flow. When true, the publisher
# must be a different governance account from the recorded reviewer.
REQUIRE_SECOND_REVIEWER=false
SHARIA_SOURCE_SCAN_INTERVAL_HOURS=24
SHARIA_SCRAPER_CONCURRENCY=1
SHARIA_SCRAPER_OBEY_ROBOTS=true
SHARIA_SCRAPER_DOWNLOAD_DELAY_SECONDS=1
SHARIA_PILOT_SYMBOLS=BTC,ETH,SOL
SHARIA_PROCESS_REMAINING_IMPORTS=false
TRACEDGE_MARKET_DATA_MODE=ccxt
TRACEDGE_FIXTURE_MARKET_DATA_ENABLED=false
MARKET_DATA_PROVIDER=ccxt
MARKET_DATA_EXCHANGE=binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443
BINANCE_SPOT_API_BASE=https://api.binance.com
BINANCE_FUTURES_API_BASE=https://fapi.binance.com
BINANCE_MARKET_DATA_ENABLED=true
BINANCE_ORDER_BOOK_ENABLED=true
BINANCE_DERIVATIVES_ENABLED=false
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_REST_BASE_URL=https://api.bybit.com
BYBIT_WS_BASE_URL=wss://stream.bybit.com/v5/public/spot
# Optional public/provider-required data sources. Disabled for beta unless adapter,
# proof support, rate limits, and tests are configured.
COINGECKO_API_BASE=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
COINGECKO_PLAN=none
COINGECKO_ENABLED=false
ALTERNATIVE_ME_API_BASE=https://api.alternative.me
ALTERNATIVE_ME_ENABLED=false
FRED_API_BASE=https://api.stlouisfed.org/fred
FRED_API_KEY=
FRED_ENABLED=false
TELEGRAM_ENABLED=false
TELEGRAM_ADAPTER=none
# Official Meta WhatsApp Cloud API. Keep disabled until the Meta business,
# phone number, webhook, token, and any required templates are configured.
WHATSAPP_ENABLED=false
WHATSAPP_ADAPTER=none
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_BUSINESS_PHONE_E164=
WHATSAPP_DEFAULT_LANGUAGE=en_US
WHATSAPP_HTTP_TIMEOUT_SECONDS=15
WHATSAPP_MAX_DELIVERY_ATTEMPTS=5
WHATSAPP_OPPORTUNITY_ALERTS_ENABLED=false
WHATSAPP_TEMPLATE_NAMES={}
WHATSAPP_OPT_IN_VERSION=2026-07
WHATSAPP_MARK_INBOUND_READ=true
WHATSAPP_WEBHOOK_RECEIPT_RETENTION_DAYS=30
BILLING_ENABLED=false
BILLING_PROVIDER=static
BILLING_CHECKOUT_TTL_MINUTES=30
BILLING_TERMS_VERSION=2026-07
BILLING_PAYMENT_AMOUNT_TOLERANCE_PERCENT=0
BILLING_ALLOW_OVERPAYMENT=false
PAYMENT_EMAIL_MAX_ATTEMPTS=5
PAYMENT_EMAIL_RETRY_MINUTES=15
STRIPE_SECRET_KEY=
STRIPE_PRICE_IDS={}
STRIPE_API_BASE=https://api.stripe.com
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io
NOWPAY_EMAIL=
NOWPAY_PASSWORD=
# Application-wide abuse controls. Deployed environments fail closed when Redis
# cannot enforce these limits. Override the JSON only as one complete object.
API_RATE_LIMITING_ENABLED=true
API_RATE_LIMIT_FAIL_CLOSED=true
API_RATE_LIMITS={"authentication":{"limit":10,"window_seconds":900},"ai_chat":{"limit":30,"window_seconds":60},"market_check":{"limit":20,"window_seconds":60},"checkout":{"limit":5,"window_seconds":300},"portal":{"limit":10,"window_seconds":300},"support":{"limit":5,"window_seconds":3600},"passport_report":{"limit":5,"window_seconds":3600},"telegram_test":{"limit":5,"window_seconds":300},"whatsapp_test":{"limit":5,"window_seconds":300},"public_chat":{"limit":20,"window_seconds":60},"public_inquiry":{"limit":5,"window_seconds":3600},"admin_mutation":{"limit":30,"window_seconds":60}}
AI_INTERPRETER_PROVIDER=openai
# Server-side only. Used by AI Setup Chat and structured strategy interpretation.
OPENAI_API_KEY=
# Optional model override. The default is the project's low-cost structured-output model.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-nano
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=20
OPENAI_EXPLANATION_ENABLED=true
# Setup Chat routing changes model cost/latency only; it never changes tool or approval authority.
AI_SETUP_SIMPLE_MODEL=gpt-5.4-nano
AI_SETUP_SIMPLE_REASONING_EFFORT=low
AI_SETUP_COMPLEX_MODEL=gpt-5.4-mini
AI_SETUP_COMPLEX_REASONING_EFFORT=medium
AI_SETUP_COMPLEX_CONDITION_THRESHOLD=4
AI_SETUP_REPEATED_CORRECTION_THRESHOLD=2
AI_SETUP_LOW_CAPABILITY_CONFIDENCE=0.72
# Bounded Setup Chat orchestration is live for the controlled beta. Setting
# AI_AGENT_CONTROL_ENABLED=false immediately restores the legacy guided flow.
AI_AGENT_CONTROL_ENABLED=true
AI_AGENT_SHADOW_MODE=false
# All authenticated beta users receive the live bounded coordinator.
AI_AGENT_ROLLOUT_PERCENT=100
AI_AGENT_MAX_STEPS=4
AI_AGENT_MAX_TOOL_CALLS_PER_TURN=4
AI_AGENT_MAX_REPEATED_CALLS=1
AI_AGENT_TIMEOUT_SECONDS=45
AI_AGENT_TOOL_TIMEOUT_SECONDS=30
AI_AGENT_MAX_OUTPUT_TOKENS=1800
AI_AGENT_MAX_ESTIMATED_COST_USD_PER_TURN=0.02
AI_AGENT_PARALLEL_TOOL_CALLS=false
# Optional AI semantic fallback for unresolved prompt fragments.
# Disabled by default. Deterministic parser always runs first, and AI output
# is validated against the capability registry before any condition is created.
AI_SEMANTIC_FALLBACK_ENABLED=false
AI_SEMANTIC_FALLBACK_MODEL=gpt-5.4-nano
AI_SEMANTIC_FALLBACK_MIN_CONFIDENCE=0.85
AI_SEMANTIC_FALLBACK_REVIEW_CONFIDENCE=0.65
AI_SEMANTIC_FALLBACK_CACHE_TTL_SECONDS=86400
AI_SEMANTIC_FALLBACK_MAX_CALLS_PER_PROMPT=2
AI_SEMANTIC_FALLBACK_MAX_FRAGMENT_CHARS=160
# Hybrid shortlist reranking. AI can select only registry-provided immutable capability keys.
AI_CAPABILITY_RERANKER_ENABLED=true
AI_CAPABILITY_RERANKER_MIN_CONFIDENCE=0.86
AI_CAPABILITY_RERANKER_CANDIDATE_LIMIT=24
CAPABILITY_EMBEDDINGS_ENABLED=true
CAPABILITY_EMBEDDING_MODEL=text-embedding-3-small
CAPABILITY_EMBEDDING_DIMENSIONS=256
# Certified non-existing mechanics use a constrained JSON AST, never generated Python.
CAPABILITY_EXTENSION_ENABLED=true
CAPABILITY_EXTENSION_DRAFT_MODEL=gpt-5.4-nano
CAPABILITY_EXTENSION_DRAFT_REASONING_EFFORT=low
CAPABILITY_EXTENSION_IMPLEMENTATION_MODEL=gpt-5.4-nano
CAPABILITY_EXTENSION_REVIEW_MODEL=gpt-5.4-mini
CAPABILITY_EXTENSION_REPAIR_SERVICE_TIER=flex
CAPABILITY_EXTENSION_AI_MAX_ATTEMPTS=3
CAPABILITY_EXTENSION_FLEX_TIMEOUT_SECONDS=900
CAPABILITY_EXTENSION_PREFLIGHT_EXCHANGE=binance
CAPABILITY_EXTENSION_PREFLIGHT_MAX_SYMBOLS=200
CAPABILITY_EXTENSION_PREFLIGHT_CONCURRENCY=8
CAPABILITY_EXTENSION_CANDLE_LIMIT=500
CAPABILITY_EXTENSION_MAX_HISTORY_CANDLES=25000
CAPABILITY_EXTENSION_MARKET_TEST_CANDLE_BUDGET=300000
CAPABILITY_EXTENSION_EMPTY_SCAN_THRESHOLD=5
CAPABILITY_EXTENSION_NO_NOTIFICATION_THRESHOLD=5
CAPABILITY_EXTENSION_MIN_CANDIDATE_RATE=0.0005
CAPABILITY_EXTENSION_MAX_CANDIDATE_RATE=0.35
CAPABILITY_EXTENSION_CERTIFICATION_SCORE=85
CAPABILITY_EXTENSION_DAILY_LIMIT=3
# Optional enrichment endpoint. POST JSON:
# {"exchange":"binance","symbols":["BTC/USDT"]}
# Response: {"symbols":{"BTC/USDT":{"category":"layer-1","market_cap":123}}}
MARKET_METADATA_API_URL=
MARKET_METADATA_API_KEY=
MARKET_METADATA_TIMEOUT_SECONDS=15
UNIVERSE_METADATA_CONCURRENCY=8
ON_DEMAND_SCAN_CONCURRENCY=8
# Optional condition-context providers. Bybit spot data is read from BYBIT_* above,
# not from these CRYPTO_INDEX/TOKEN_CATEGORY placeholders. Leave these blank in the
# spot-only beta unless you add a real global-index/category provider and tests.
# Each endpoint receives a POST body containing category, requested_keys, exchange,
# symbol, timeframe, quote_assets and evaluated_at. It must return
# {"values":{"condition_key":true_or_number},"as_of":"ISO-8601"}.
CRYPTO_INDEX_API_URL=
CRYPTO_INDEX_API_KEY=
MACRO_MARKET_API_URL=
MACRO_MARKET_API_KEY=
EVENT_FEED_API_URL=
EVENT_FEED_API_KEY=
TOKEN_CATEGORY_API_URL=
TOKEN_CATEGORY_API_KEY=
# Derivatives are disabled for the spot-only product. Keep these empty.
DERIVATIVES_CONTEXT_API_URL=
DERIVATIVES_CONTEXT_API_KEY=
CONTEXT_PROVIDER_TIMEOUT_SECONDS=15
CONTEXT_FETCH_CONCURRENCY=8
MARKET_BREADTH_MAX_SYMBOLS=100
SUPPORT_EMAIL=contact@trace-edge.com
SUPPORT_TELEGRAM_USERNAME=
ADMIN_NOTIFY_TELEGRAM_USER_ID=
# Email delivery for one-time login and password-reset codes.
# Set EMAIL_ADAPTER=smtp in production. The memory adapter is test-only.
# Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=2587, SMTP_USERNAME=resend,
# SMTP_PASSWORD=<Resend API key>, SMTP_USE_TLS=true, SMTP_USE_SSL=false.
# Local no-send adapter. Staging/production public chat requires real SMTP.
EMAIL_ADAPTER=memory
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=HilalMarkets
SMTP_USE_TLS=true
SMTP_USE_SSL=false
AUTH_CODE_TTL_MINUTES=10
AUTH_CODE_MAX_ATTEMPTS=5
# Public product assistant. AI responses are grounded in server-owned product
# knowledge and read-only tools; unresolved questions use the email handoff.
PUBLIC_CHAT_ENABLED=true
PUBLIC_CHAT_AI_ENABLED=true
PUBLIC_CHAT_INQUIRY_EMAIL=office@hilalmarkets.com
PUBLIC_CHAT_PROFILE_VERSION=1
PUBLIC_CHAT_MESSAGE_MAX_LENGTH=800
PUBLIC_CHAT_INQUIRY_MAX_LENGTH=4000
PUBLIC_CHAT_ANSWER_AUDIT_RETENTION_DAYS=90
PUBLIC_CHAT_INQUIRY_RETENTION_DAYS=365
PUBLIC_CHAT_EMAIL_MAX_ATTEMPTS=5
PUBLIC_CHAT_EMAIL_RETRY_MINUTES=15
PUBLIC_CHAT_EMAIL_CLAIM_TIMEOUT_MINUTES=10
PUBLIC_CHAT_AI_MODEL=gpt-5.4-nano
PUBLIC_CHAT_AI_REASONING_EFFORT=low
PUBLIC_CHAT_AI_TIMEOUT_SECONDS=30
PUBLIC_CHAT_AI_MAX_OUTPUT_TOKENS=1200
PUBLIC_CHAT_AI_MAX_ESTIMATED_COST_USD_PER_TURN=0.015
PUBLIC_CHAT_AI_MIN_CONFIDENCE=0.55
PUBLIC_CHAT_AI_MAX_HISTORY_MESSAGES=12
PUBLIC_CHAT_AI_MAX_READ_TOOLS=3
PUBLIC_CHAT_SESSION_MAX_TURNS=40
PUBLIC_CHAT_AI_PROVIDER_ATTEMPTS=2
PUBLIC_CHAT_AI_CIRCUIT_FAILURE_THRESHOLD=5
PUBLIC_CHAT_AI_CIRCUIT_RESET_SECONDS=60
PUBLIC_CHAT_SESSION_RETENTION_DAYS=30
# Protected administrator console at /system-brain. Generate the hash with
# `python -c "from ai_market_monitor.core.security import hash_password; print(hash_password('replace-me'))"`
# and store only the output. SMTP must be configured so the OTP can be delivered.
SYSTEM_BRAIN_ADMIN_USERNAME=contact@trace-edge.com
SYSTEM_BRAIN_ADMIN_PASSWORD_HASH=
SYSTEM_BRAIN_OTP_TTL_MINUTES=10
SYSTEM_BRAIN_OTP_MAX_ATTEMPTS=5
SYSTEM_BRAIN_SESSION_HOURS=8
SYSTEM_BRAIN_LOGIN_ATTEMPTS_PER_15_MINUTES=5
# Production should set this true only after Cloudflare Access protects the origin.
# The app then requires both Access headers before its own password + OTP authorization.
SYSTEM_BRAIN_CLOUDFLARE_ACCESS_REQUIRED=false
# USD per one million tokens. Reasoning tokens are included in output tokens.
# Verify prices against official OpenAI pricing before changing production models.
OPENAI_MODEL_PRICING_USD_PER_MILLION={"gpt-5.4-nano":{"input":0.20,"cached_input":0.02,"output":1.25},"gpt-5.4-mini":{"input":0.75,"cached_input":0.075,"output":4.50},"gpt-5-nano":{"input":0.05,"cached_input":0.005,"output":0.40}}
DASHBOARD_EXPORT_DIRECTORY=./exports
CHART_LIBRARY_CDN_URL=https://unpkg.com/lightweight-charts@4.2.0/dist/lightweight-charts.standalone.production.js
# Optional local source folder for the licensed TradingView Advanced Charts / Charting Library package.
# After TradingView grants GitHub access, download/clone the official package and run:
# .venv\Scripts\python.exe scripts\install_tradingview_charting_library.py --source "C:\path\to\charting_library"
TRADINGVIEW_CHARTING_LIBRARY_SOURCE_DIR=
