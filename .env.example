WHATSAPP_OPPORTUNITY_ALERTS_ENABLED=false
# JSON map of Meta-approved template names. Required production keys:
# connection_confirmation, connection_test, account_notice, trial_update,
# subscription_update, compliance_change, evidence_update, watchlist_paused,
# integration_failure, lifecycle_update, and confirmed_research_event when
# opportunity alerts are enabled. See docs/WHATSAPP_CLOUD_API_RUNBOOK.md.
WHATSAPP_TEMPLATE_NAMES={}
WHATSAPP_OPT_IN_VERSION=2026-07
WHATSAPP_MARK_INBOUND_READ=true
WHATSAPP_WEBHOOK_RECEIPT_RETENTION_DAYS=30
# Set true only after the selected provider credentials, webhooks, and every
# required product mapping below have been configured and verified.
BILLING_ENABLED=false
# Select providers by payment method. The legacy BILLING_PROVIDER remains a
# local/backward-compatible fallback when these are disabled.
#
# "disabled" is the safe default for a new environment, which has no payment
# accounts yet. A method left disabled is drawn switched off wherever the product
# offers a choice, so nobody can pick a way of paying that checkout would refuse.
# The deployed HilalMarkets server runs BILLING_CARD_PROVIDER=creem and
# BILLING_CRYPTO_PROVIDER=nowpayments; those live in the real .env files, which are
# not in git.
BILLING_PROVIDER=static
BILLING_CARD_PROVIDER=disabled
BILLING_CRYPTO_PROVIDER=disabled
BILLING_CHECKOUT_TTL_MINUTES=30
BILLING_TERMS_VERSION=2026-07
BILLING_PAYMENT_AMOUNT_TOLERANCE_PERCENT=0
BILLING_ALLOW_OVERPAYMENT=false
# Every discount code this deployment honours, as CODE=percent pairs
# (HILAL25=25,TINYTALES=30). Codes are looked up in Creem first; this list answers
# when Creem is not configured, has never heard of the code, or cannot be reached.
# Left blank here on purpose: a real code belongs in .env / .env.production, which
# are not in git. The launch code HILAL25 may be listed, but only at the percentage
# core/plans.py already gives it - a different number refuses to start, because the
# pricing pages quote plans.py and the checkout would charge this.
BILLING_DISCOUNT_CODES=
PAYMENT_EMAIL_MAX_ATTEMPTS=5
PAYMENT_EMAIL_RETRY_MINUTES=15
STRIPE_SECRET_KEY=
STRIPE_PRICE_IDS={}
STRIPE_API_BASE=https://api.stripe.com
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
# Required keys when Creem is enabled: one per plan and period that is really on
# sale, read from core/plans.py. Today that is trader_monthly alone. A product for
# something nobody can buy is never required, and the day a plan or a yearly price
# opens, its key becomes required with it. A trial is optional and remains
# unavailable until a separately verified Creem trial product is configured.
CREEM_PRODUCT_IDS={}
CREEM_API_BASE=https://test-api.creem.io
CREEM_TIMEOUT_SECONDS=20
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io
NOWPAY_EMAIL=
NOWPAY_PASSWORD=
# Application-wide abuse controls. Deployed environments fail closed when Redis
# cannot enforce these limits. Override the JSON only as one complete object.
API_RATE_LIMITING_ENABLED=true
API_RATE_LIMIT_FAIL_CLOSED=true
API_RATE_LIMITS={"authentication":{"limit":10,"window_seconds":900},"ai_chat":{"limit":30,"window_seconds":60},"market_check":{"limit":20,"window_seconds":60},"checkout":{"limit":5,"window_seconds":300},"portal":{"limit":10,"window_seconds":300},"support":{"limit":5,"window_seconds":3600},"passport_report":{"limit":5,"window_seconds":3600},"telegram_test":{"limit":5,"window_seconds":300},"whatsapp_test":{"limit":5,"window_seconds":300},"public_chat":{"limit":20,"window_seconds":60},"public_inquiry":{"limit":5,"window_seconds":3600},"public_waitlist":{"limit":5,"window_seconds":3600},"public_contact":{"limit":5,"window_seconds":3600},"site_analytics":{"limit":120,"window_seconds":60},"admin_mutation":{"limit":30,"window_seconds":60}}
AI_INTERPRETER_PROVIDER=openai
# Server-side only. Used by AI Setup Chat and structured strategy interpretation.
OPENAI_API_KEY=
# Optional model override. The default is the project's low-cost structured-output model.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
# Test-process controls for the authenticated AI Setup Chat evaluator. Runtime
# validation rejects these in staging/production. Version labels map only to
# server-owned model/prompt variants; customers cannot supply model names.
AI_SETUP_EVALUATOR_ENABLED=false
AI_SETUP_EVALUATOR_FAULTS_ENABLED=false
AI_SETUP_EVALUATOR_TARGET_VERSIONS={}
# The authenticated Setup Chat path. There is no other writable route, so this stays
# true; startup validation rejects false.
SETUP_CHAT_LAUNCH_V2_ENABLED=true
SETUP_CHAT_EMERGENCY_DISABLED=false
SETUP_CHAT_PRIVATE_BETA_USER_IDS=[]
# Test-only compatibility path. Staging and production reject true.
SETUP_CHAT_LEGACY_TEST_COMPAT_ENABLED=false

# --- Setup Agent bounds. These are the values that govern Setup Chat traffic. ---
# One planning call per turn, plus at most this many retries, and only for a transport
# failure. A schema or grounding failure is never retried.
SETUP_AGENT_PLANNER_MAX_OUTPUT_TOKENS=8000
SETUP_AGENT_COMPOSER_MAX_OUTPUT_TOKENS=1600
SETUP_AGENT_PLANNER_TIMEOUT_SECONDS=60
SETUP_AGENT_COMPOSER_TIMEOUT_SECONDS=10
SETUP_AGENT_SIMPLE_SERVICE_TIER=default
SETUP_AGENT_COMPLEX_SERVICE_TIER=default
SETUP_AGENT_MAX_ESTIMATED_COST_USD_PER_TURN=0.10
SETUP_AGENT_MAX_ESTIMATED_COST_USD_PER_USER_DAY=2.00
SETUP_AGENT_CIRCUIT_BREAKER_FAILURES=5
SETUP_AGENT_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
SETUP_PROVIDER_PREFLIGHT_TTL_SECONDS=300
SETUP_SCREENING_RESOLUTION_TTL_SECONDS=300
SETUP_METHODOLOGY_VERSION_TTL_SECONDS=300
SETUP_APPROVED_WATCHLIST_TTL_SECONDS=300
OPENAI_TIMEOUT_SECONDS=20
OPENAI_EXPLANATION_ENABLED=true
# Setup Chat routing changes model cost/latency only; it never changes tool or approval authority.
AI_SETUP_SIMPLE_MODEL=gpt-5.6-luna
AI_SETUP_SIMPLE_REASONING_EFFORT=low
AI_SETUP_COMPLEX_MODEL=gpt-5.6-luna
AI_SETUP_COMPLEX_REASONING_EFFORT=low
AI_SETUP_COMPLEX_CONDITION_THRESHOLD=4
AI_SETUP_REPEATED_CORRECTION_THRESHOLD=2
AI_SETUP_LOW_CAPABILITY_CONFIDENCE=0.72
# Bounded Agent Control is the OLD general coordinator. It has no authority over
# authenticated Setup Chat: that path is the Setup Agent above, and none of the
# AI_AGENT_* values below govern it. Retained for isolated experiments only, and off by
# default — turning it on does not change Setup Chat, and turning it off is not a Setup
# Chat rollback.
AI_AGENT_CONTROL_ENABLED=false
AI_AGENT_SHADOW_MODE=false
AI_AGENT_ROLLOUT_PERCENT=0
AI_AGENT_MAX_STEPS=4
AI_AGENT_MAX_TOOL_CALLS_PER_TURN=4
AI_AGENT_MAX_REPEATED_CALLS=1
AI_AGENT_TIMEOUT_SECONDS=45
AI_AGENT_TOOL_TIMEOUT_SECONDS=30
AI_AGENT_MAX_OUTPUT_TOKENS=1800
AI_AGENT_MAX_ESTIMATED_COST_USD_PER_TURN=0.02
AI_AGENT_PARALLEL_TOOL_CALLS=false

# Integrated evaluator CLI. Credentials remain local and must identify a
# dedicated authenticated test user. Full real API/UI runs are manual/scheduled.
TEST_AI_MODEL=gpt-5.6-luna
TEST_AI_REASONING=none
TEST_AI_SERVICE_TIER=flex
# The evaluator prices the target the way the app actually runs it. Placeholder
# rates: gpt-5.6-luna published price, confirmed 2026-09-05.
TARGET_MODEL=gpt-5.6-luna
EVAL_MODEL_PRICING_USD_PER_MILLION={"gpt-5.6-luna":{"standard":{"input":0.2,"cached_input":0.02,"output":1.2},"flex":{"input":0.1,"cached_input":0.01,"output":0.6}}}
JUDGE_MAX_OUTPUT_TOKENS=4000
# Flex prices per 1M tokens for the evaluator model, 0.5x the published standard
# rate. Recheck when the evaluator model or service tier changes.
TEST_AI_INPUT_USD_PER_1M=0.1
TEST_AI_CACHED_INPUT_USD_PER_1M=0.01
TEST_AI_OUTPUT_USD_PER_1M=0.6
EVAL_OUTPUT_DIR=chatbot_eval_runs
EVAL_CACHE_DB=.chatbot_eval_cache.sqlite3
EVAL_BUDGET_USD=2.5
# The budget profile clamps any larger CLI override to this all-in limit.
EVAL_BUDGET_PROFILE_MAX_USD=2.5
EVAL_MAX_CONCURRENCY=2
EVAL_DEFAULT_TESTS_PER_TOPIC=24
EVAL_READINESS_ATTEMPTS=2
EVAL_CIRCUIT_BREAKER_FAILURES=2
TARGET_STRATEGY_SCHEMA_FILE=tests/evaluator/contracts/strategy_definition.schema.json
TARGET_SCHEMA_FILE=tests/evaluator/contracts/setup_chat_evaluation_contract.schema.json
TARGET_FIELD_MAP_FILE=tests/evaluator/contracts/field_map.json
TARGET_BACKEND_ADAPTER=hilalmarkets
TARGET_BACKEND_BASE_URL=http://127.0.0.1:8000
TARGET_BACKEND_SESSION_PATH=/api/v1/dashboard/setup-chat/sessions
TARGET_BACKEND_MESSAGE_PATH_TEMPLATE=/api/v1/dashboard/setup-chat/sessions/{chat_id}/messages
TARGET_BACKEND_LOGIN_PATH=/signin
TARGET_BACKEND_EMAIL=
TARGET_BACKEND_PASSWORD=
# Optional short-lived session for scheduled black-box runs. Keep secret and
# prefer a dedicated evaluator account; this value is never written to reports.
TARGET_SESSION_COOKIE=
TARGET_UI_URL=http://127.0.0.1:8000/dashboard/strategies/new
TARGET_UI_EMAIL=
TARGET_UI_PASSWORD=
TARGET_UI_HEADLESS=true
TARGET_VARIANTS_JSON=[]
# Optional AI semantic fallback for unresolved prompt fragments.
# Disabled by default. Deterministic parser always runs first, and AI output
# is validated against the capability registry before any condition is created.
AI_SEMANTIC_FALLBACK_ENABLED=false
AI_SEMANTIC_FALLBACK_MODEL=gpt-5.6-luna
AI_SEMANTIC_FALLBACK_MIN_CONFIDENCE=0.85
AI_SEMANTIC_FALLBACK_REVIEW_CONFIDENCE=0.65
AI_SEMANTIC_FALLBACK_CACHE_TTL_SECONDS=86400
AI_SEMANTIC_FALLBACK_MAX_CALLS_PER_PROMPT=2
AI_SEMANTIC_FALLBACK_MAX_FRAGMENT_CHARS=160
# Hybrid shortlist reranking. AI can select only registry-provided immutable capability keys.
AI_CAPABILITY_RERANKER_ENABLED=true
AI_CAPABILITY_RERANKER_MIN_CONFIDENCE=0.86
AI_CAPABILITY_RERANKER_CANDIDATE_LIMIT=24
CAPABILITY_EMBEDDINGS_ENABLED=true
CAPABILITY_EMBEDDING_MODEL=text-embedding-3-small
CAPABILITY_EMBEDDING_DIMENSIONS=256
# Certified non-existing mechanics use a constrained JSON AST, never generated Python.
CAPABILITY_EXTENSION_ENABLED=true
CAPABILITY_EXTENSION_DRAFT_MODEL=gpt-5.6-luna
CAPABILITY_EXTENSION_DRAFT_REASONING_EFFORT=low
CAPABILITY_EXTENSION_IMPLEMENTATION_MODEL=gpt-5.6-luna
CAPABILITY_EXTENSION_REVIEW_MODEL=gpt-5.6-luna
CAPABILITY_EXTENSION_REPAIR_SERVICE_TIER=flex
CAPABILITY_EXTENSION_AI_MAX_ATTEMPTS=3
CAPABILITY_EXTENSION_FLEX_TIMEOUT_SECONDS=900
CAPABILITY_EXTENSION_PREFLIGHT_EXCHANGE=binance
CAPABILITY_EXTENSION_PREFLIGHT_MAX_SYMBOLS=200
CAPABILITY_EXTENSION_PREFLIGHT_CONCURRENCY=8
CAPABILITY_EXTENSION_CANDLE_LIMIT=500
CAPABILITY_EXTENSION_MAX_HISTORY_CANDLES=25000
CAPABILITY_EXTENSION_MARKET_TEST_CANDLE_BUDGET=300000
CAPABILITY_EXTENSION_EMPTY_SCAN_THRESHOLD=5
CAPABILITY_EXTENSION_NO_NOTIFICATION_THRESHOLD=5
CAPABILITY_EXTENSION_MIN_CANDIDATE_RATE=0.0005
CAPABILITY_EXTENSION_MAX_CANDIDATE_RATE=0.35
CAPABILITY_EXTENSION_CERTIFICATION_SCORE=85
CAPABILITY_EXTENSION_DAILY_LIMIT=3
# Optional enrichment endpoint. POST JSON:
# {"exchange":"binance","symbols":["BTC/USDT"]}
# Response: {"symbols":{"BTC/USDT":{"category":"layer-1","market_cap":123}}}
MARKET_METADATA_API_URL=
MARKET_METADATA_API_KEY=
MARKET_METADATA_TIMEOUT_SECONDS=15
UNIVERSE_METADATA_CONCURRENCY=8
# How many symbols the product asks the exchange about at once. One number for both the
# scheduled scan and the one a person triggers, because it answers one question: how hard
# we may lean on the exchange. It replaced ON_DEMAND_SCAN_CONCURRENCY, which only the
# by-hand scan read - the scheduled scan overlapped nothing and took 198 seconds.
# Raising it past the point where ccxt's own rate limiter is the slow part buys nothing:
# concurrency overlaps waiting for an answer, it cannot overlap the 50ms-per-weight
# spacing ccxt applies. Sending fewer requests is what helps - see MARKET_CACHE_ENABLED.
SCAN_SYMBOL_CONCURRENCY=8
# Share one reading of a market between every monitor that wants it. Fifty monitors on
# one-minute candles nearly all ask about the same markets; without this each one pays the
# exchange separately for an identical answer. Measured against Binance on 24 Aug 2026:
# 302 candles cost 100ms of rate-limit sleep, and the unfiltered ticker endpoint costs
# 4000ms and 1.9MB. Off is the old behaviour.
MARKET_CACHE_ENABLED=true
# The longest one stored reading may be reused, in seconds. The real window is
# min(one candle, this). The candle half is free - inside one 1m candle every monitor
# wants the same closed candles. This half stops a daily monitor holding one reading for
# a whole day while its forming candle never moves.
MARKET_CACHE_MAX_AGE_SECONDS=60
# Optional condition-context providers. Bybit spot data is read from BYBIT_* above,
# not from these CRYPTO_INDEX/TOKEN_CATEGORY placeholders. Leave these blank in the
# spot-only beta unless you add a real global-index/category provider and tests.
# Each endpoint receives a POST body containing category, requested_keys, exchange,
# symbol, timeframe, quote_assets and evaluated_at. It must return
# {"values":{"condition_key":true_or_number},"as_of":"ISO-8601"}.
CRYPTO_INDEX_API_URL=
CRYPTO_INDEX_API_KEY=
MACRO_MARKET_API_URL=
MACRO_MARKET_API_KEY=
EVENT_FEED_API_URL=
EVENT_FEED_API_KEY=
TOKEN_CATEGORY_API_URL=
TOKEN_CATEGORY_API_KEY=
# Derivatives are disabled for the spot-only product. Keep these empty.
DERIVATIVES_CONTEXT_API_URL=
DERIVATIVES_CONTEXT_API_KEY=
CONTEXT_PROVIDER_TIMEOUT_SECONDS=15
CONTEXT_FETCH_CONCURRENCY=8
MARKET_BREADTH_MAX_SYMBOLS=100
SUPPORT_EMAIL=contact@trace-edge.com
SUPPORT_TELEGRAM_USERNAME=
ADMIN_NOTIFY_TELEGRAM_USER_ID=
# Email delivery for one-time login and password-reset codes.
# Set EMAIL_ADAPTER=smtp in production. The memory adapter is test-only.
# Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=2587, SMTP_USERNAME=resend,
# SMTP_PASSWORD=<Resend API key>, SMTP_USE_TLS=true, SMTP_USE_SSL=false.
# Local no-send adapter. Staging/production public chat requires real SMTP.
EMAIL_ADAPTER=memory
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# The name a person sees in their inbox, so it is prose and follows the brand rule:
# "Hilal Markets" with a space (`brand guide.md` section 4). Written without one, every
# email the product sends breaks the rule in the most visible place there is.
SMTP_FROM_NAME=Hilal Markets
SMTP_USE_TLS=true
SMTP_USE_SSL=false
AUTH_CODE_TTL_MINUTES=10
AUTH_CODE_MAX_ATTEMPTS=5
# The Google button on the sign-up and sign-in pages.
#
# Both values come from one Google Cloud "OAuth client ID" of type Web application.
# The button is only drawn once both are filled in; while either is empty the pages
# offer the email door alone and the two Google routes refuse politely.
#
# In the Google Cloud console, "Authorised redirect URIs" must contain one line for
# EVERY name this deployment answers on, because both of them serve the sign-in pages
# and the trip has to come back to the name it started on:
#   <PUBLIC_BASE_URL>/auth/google/callback
#   <APP_BASE_URL>/auth/google/callback      (only when APP_BASE_URL is a different host)
# Miss one and the button works on one name and silently does nothing on the other.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_TTL_MINUTES=10
# First-party visit counting for the public site, read on the System Brain Stats page:
# how many people, how long they stayed, what they did next. It writes nothing to the
# visitor's browser and stores no address, so it is independent of the cookie banner.
# Set to false to stop measuring; the collector then accepts and discards.
SITE_VISIT_MEASUREMENT_ENABLED=true
# Public product assistant. AI responses are grounded in server-owned product
# knowledge and read-only tools; unresolved questions use the email handoff.
PUBLIC_CHAT_ENABLED=true
PUBLIC_CHAT_AI_ENABLED=true
PUBLIC_CHAT_INQUIRY_EMAIL=office@hilalmarkets.com
PUBLIC_FORMS_ENABLED=true

# --- Hilal, the assistant inside the dashboard -------------------------------
# A different assistant from the public site's support chat. This one answers a
# signed-in customer about listings, Passports, screening standards, reports and
# their plan. It never builds a strategy and never gives financial advice.
HILAL_CHAT_ENABLED=true
HILAL_CHAT_AI_MODEL=gpt-5.6-luna
HILAL_CHAT_AI_REASONING_EFFORT=low
HILAL_CHAT_AI_TIMEOUT_SECONDS=30
HILAL_CHAT_AI_MAX_OUTPUT_TOKENS=900
HILAL_CHAT_AI_MAX_ESTIMATED_COST_USD_PER_TURN=0.02
HILAL_CHAT_AI_PROVIDER_ATTEMPTS=2
HILAL_CHAT_AI_CIRCUIT_FAILURE_THRESHOLD=5
HILAL_CHAT_AI_CIRCUIT_RESET_SECONDS=60
HILAL_CHAT_AI_MAX_HISTORY_MESSAGES=16
HILAL_CHAT_MESSAGE_MAX_LENGTH=800
HILAL_CHAT_COMMENT_MAX_LENGTH=2000
# What one person may spend on Hilal per 24-hour cycle. The cycle is the UTC day,
# so it resets at 00:00 UTC. A paying subscriber gets the multiplier below.
HILAL_CHAT_FREE_DAILY_USD=0.10
# Only used when the paid figure below is left empty. Being a whole number, it ties the
# two allowances to one dial: 0.15 free can only buy 0.15, 0.30, 0.45 and so on.
HILAL_CHAT_PAID_DAILY_MULTIPLIER=5
# The subscriber's allowance stated outright. Set it to choose the two figures
# independently; it wins over the multiplier. Startup refuses a value below the free one.
HILAL_CHAT_PAID_DAILY_USD=
HILAL_CHAT_MAX_EVIDENCE_ASSETS=24
HILAL_CHAT_RETENTION_DAYS=365
# The emergency brake over the public site. While it is true, every public page asks
# the visitor to join the waitlist instead: no plans, no plan comparison, no sign-in or
# sign-up button, no menu entry into the dashboard, and a support assistant that never
# sends an anonymous visitor to an account page.
#
# The product has launched, so it is false. Turning it back on pulls the public site
# back to the waitlist without a deploy, whatever LAUNCH_STAGE says below: it is the
# ceiling over that setting and it only ever narrows exposure, never widens it.
PUBLIC_WAITLIST_MODE=false
# How open the product is. One of: internal, private_beta_invite, public_waitlist,
# public_launch. This is the authority for what the public site advertises, which
# calls to action render, whether pricing and checkout are exposed, which channels are
# offered, and what the public assistant may claim. See
# src/ai_market_monitor/core/launch_stage.py for the exposure table.
#
# Widening moves one step at a time; narrowing is allowed from anywhere, because
# pulling the product back is an emergency action. Startup refuses a stage that
# promises something the deployment cannot deliver, such as checkout with billing off.
LAUNCH_STAGE=public_launch
# --- Durable operational measurements ---------------------------------------
# Measurements are held in memory for speed and written down on a timer, so they
# survive a restart and add up across the API, the workers and the scheduler.
# See src/ai_market_monitor/observability/durable_metrics.py.
#
# Width of one stored window. Wider means fewer rows and a blunter timeline.
OBSERVABILITY_WINDOW_SECONDS=300
# How often each process writes its outstanding movement down. Keep this at or
# below the window width, or a quiet process can miss a whole window.
OBSERVABILITY_FLUSH_INTERVAL_SECONDS=60
# After this many hours, every process's rows for one window become a single row.
OBSERVABILITY_ROLLUP_AFTER_HOURS=6
# After this many hours, stored measurements are deleted. This is the only bound on
# how large the table can grow, and it must be longer than the rollup age.
OBSERVABILITY_RETENTION_HOURS=72
# --- Where a page-worthy alert actually goes ---------------------------------
# A page names a primary and a fallback route in observability/alerts.py. These say
# where those two land. Leave them empty and a page is still recorded in the
# operational issue queue, with the row saying plainly it could not be delivered.
#
# The operations Telegram chat. Deliberately not the Sharia review chat: two
# audiences, and mixing a page into a review queue buries both.
OPERATIONAL_ALERT_TELEGRAM_CHAT_ID=
OPERATIONAL_ALERT_EMAIL=
# How long one firing rule stays quiet after it has paged once. Without this an
# hour-long outage sends sixty identical messages and the channel gets muted.
OPERATIONAL_ALERT_REPEAT_MINUTES=30
OPERATIONAL_ALERT_MAX_ATTEMPTS=5
CONTACT_FORM_SENDER_EMAIL=office@hilalmarkets.com
CONTACT_FORM_RECIPIENT_EMAIL=office@hilalmarkets.com
# How many support messages are accepted, and from whom.
#
# One rule for both doors: the public /contact form and the dashboard's support form.
# Both count from the same ledger through services/support_intake.py, so two messages
# per email means two across the whole product rather than two per form.
#
# The first two are what one person may send. The third is the flood ceiling for
# everybody together, which is what stops a crowd of fresh addresses doing what one
# address cannot. Startup refuses a per-person limit above the ceiling.
SUPPORT_INTAKE_MAX_PER_EMAIL=2
SUPPORT_INTAKE_MAX_PER_CLIENT=2
SUPPORT_INTAKE_MAX_PER_HOUR=20
# The period all three are counted over, in seconds. 3600 is one hour.
SUPPORT_INTAKE_WINDOW_SECONDS=3600
PUBLIC_FORM_EMAIL_MAX_ATTEMPTS=5
PUBLIC_FORM_EMAIL_RETRY_MINUTES=15
PUBLIC_FORM_DELIVERY_CLAIM_TIMEOUT_MINUTES=10
# This is a deployed Google Apps Script Web App /exec URL, not a browser Sheet URL.
# It is server-only and is never rendered into the landing page.
WAITLIST_GOOGLE_SHEETS_ENABLED=false
WAITLIST_GOOGLE_SHEETS_WEBHOOK_URL=
WAITLIST_GOOGLE_SHEETS_WEBHOOK_SECRET=
WAITLIST_GOOGLE_SHEETS_TIMEOUT_SECONDS=15
WAITLIST_GOOGLE_SHEETS_MAX_ATTEMPTS=8
WAITLIST_GOOGLE_SHEETS_RETRY_MINUTES=15
WAITLIST_TRUST_CLOUDFLARE_COUNTRY_HEADER=false
PUBLIC_CHAT_PROFILE_VERSION=1
PUBLIC_CHAT_MESSAGE_MAX_LENGTH=800
PUBLIC_CHAT_INQUIRY_MAX_LENGTH=4000
PUBLIC_CHAT_ANSWER_AUDIT_RETENTION_DAYS=90
PUBLIC_CHAT_INQUIRY_RETENTION_DAYS=365
PUBLIC_CHAT_EMAIL_MAX_ATTEMPTS=5
PUBLIC_CHAT_EMAIL_RETRY_MINUTES=15
PUBLIC_CHAT_EMAIL_CLAIM_TIMEOUT_MINUTES=10
PUBLIC_CHAT_AI_MODEL=gpt-5.6-luna
PUBLIC_CHAT_AI_REASONING_EFFORT=low
PUBLIC_CHAT_AI_TIMEOUT_SECONDS=30
PUBLIC_CHAT_AI_MAX_OUTPUT_TOKENS=1200
PUBLIC_CHAT_AI_MAX_ESTIMATED_COST_USD_PER_TURN=0.015
PUBLIC_CHAT_AI_MIN_CONFIDENCE=0.55
PUBLIC_CHAT_AI_MAX_HISTORY_MESSAGES=12
PUBLIC_CHAT_AI_MAX_READ_TOOLS=3
PUBLIC_CHAT_SESSION_MAX_TURNS=40
PUBLIC_CHAT_AI_PROVIDER_ATTEMPTS=2
PUBLIC_CHAT_AI_CIRCUIT_FAILURE_THRESHOLD=5
PUBLIC_CHAT_AI_CIRCUIT_RESET_SECONDS=60
PUBLIC_CHAT_SESSION_RETENTION_DAYS=30
# Bounded read-only context from project-owned Notion exports. These files can
# improve wording and topic recall, but cannot authorize current product facts.
PUBLIC_CHAT_NOTION_ENABLED=true
PUBLIC_CHAT_NOTION_ROOT=./Notion
PUBLIC_CHAT_NOTION_MAX_DOCUMENTS=6
PUBLIC_CHAT_NOTION_MAX_CHARACTERS=12000
PUBLIC_CHAT_NOTION_MAX_FILE_BYTES=262144
# Read-only Cloudflare API token, used by scripts/cloudflare_probe.py to check DNS, TLS
# mode and zone status. Create it under My Profile -> API Tokens, scope it to the one zone,
# and give it a TTL. This opens Cloudflare's API, never a page behind Cloudflare Access.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Protected administrator console at /system-brain. Generate the hash with
# `python -c "from ai_market_monitor.core.security import hash_password; print(hash_password('replace-me'))"`
# and store only the output. SMTP must be configured so the OTP can be delivered.
SYSTEM_BRAIN_ADMIN_USERNAME=contact@trace-edge.com
SYSTEM_BRAIN_ADMIN_EMAILS=
SYSTEM_BRAIN_ADMIN_PASSWORD_HASH=
SYSTEM_BRAIN_OTP_TTL_MINUTES=10
SYSTEM_BRAIN_OTP_MAX_ATTEMPTS=5
SYSTEM_BRAIN_SESSION_HOURS=8
SYSTEM_BRAIN_LOGIN_ATTEMPTS_PER_15_MINUTES=5
# Production should set this true only after Cloudflare Access protects the origin.
# The app then requires both Access headers before its own password + OTP authorization.
SYSTEM_BRAIN_CLOUDFLARE_ACCESS_REQUIRED=false
# Machine access through Cloudflare Access, for scripts rather than people. Create the
# token under Zero Trust -> Access -> Service Auth, then add it to the Access policy.
# The two sides face opposite ways: _IDS is the allowlist this app checks callers against
# and holds only public client IDs, while _CLIENT_ID / _CLIENT_SECRET is what this
# machine sends when it calls the site. Empty _IDS keeps machine access closed.
SYSTEM_BRAIN_ACCESS_SERVICE_TOKEN_IDS=
SYSTEM_BRAIN_ACCESS_CLIENT_ID=
SYSTEM_BRAIN_ACCESS_CLIENT_SECRET=
SYSTEM_BRAIN_AI_ENABLED=true
SYSTEM_BRAIN_AI_MODEL=gpt-5.6-luna
SYSTEM_BRAIN_AI_REASONING_EFFORT=low
SYSTEM_BRAIN_AI_TIMEOUT_SECONDS=30
SYSTEM_BRAIN_AI_MAX_OUTPUT_TOKENS=900
SYSTEM_BRAIN_AI_MAX_CONTEXT_CHARACTERS=24000
SYSTEM_BRAIN_AI_MAX_ESTIMATED_COST_USD_PER_TURN=0.02
SYSTEM_BRAIN_AGENT_MAX_STEPS=6
SYSTEM_BRAIN_AGENT_MAX_TOOL_CALLS=8
SYSTEM_BRAIN_AGENT_MAX_REPEATED_CALLS=1
SYSTEM_BRAIN_AGENT_TOOL_TIMEOUT_SECONDS=10
SYSTEM_BRAIN_AGENT_TURN_TIMEOUT_SECONDS=50
SYSTEM_BRAIN_AGENT_MAX_HISTORY_MESSAGES=16
SYSTEM_BRAIN_AGENT_EVIDENCE_TTL_SECONDS=300
SYSTEM_BRAIN_AGENT_MAX_TURNS_PER_HOUR=30
SYSTEM_BRAIN_AGENT_MAX_COST_USD_PER_DAY=5.0
SYSTEM_BRAIN_AGENT_MAX_TOOL_PAYLOAD_CHARACTERS=24000
# USD per one million tokens. Reasoning tokens are included in output tokens.
# Verify prices against official OpenAI pricing before changing production models.
# gpt-5.6-luna rates are OpenAI's published prices, confirmed 2026-09-05.
OPENAI_MODEL_PRICING_USD_PER_MILLION={"gpt-5.4-nano":{"input":0.2,"cached_input":0.02,"output":1.25},"gpt-5.4-mini":{"input":0.75,"cached_input":0.075,"output":4.5},"gpt-5-mini":{"input":0.25,"cached_input":0.025,"output":2.0},"gpt-5-nano":{"input":0.05,"cached_input":0.005,"output":0.4},"gpt-5.6-luna":{"input":0.2,"cached_input":0.02,"output":1.2}}
OPENAI_FAST_MODEL_PRICING_USD_PER_MILLION={"gpt-5.4-mini":{"input":1.5,"cached_input":0.15,"output":9.0},"gpt-5-mini":{"input":0.45,"cached_input":0.045,"output":3.6},"gpt-5.6-luna":{"input":0.4,"cached_input":0.04,"output":2.4}}
DASHBOARD_EXPORT_DIRECTORY=./exports
CHART_LIBRARY_CDN_URL=/static/vendor/lightweight-charts.standalone.production.js
# Optional local source folder for the licensed TradingView Advanced Charts / Charting Library package.
# After TradingView grants GitHub access, download/clone the official package and run:
# .venv\Scripts\python.exe scripts\install_tradingview_charting_library.py --source "C:\path\to\charting_library"
TRADINGVIEW_CHARTING_LIBRARY_SOURCE_DIR=

# --- Setup Chat surface switches and bounds ----------------------------------
# One switch per surface, on purpose. When the planner is failing, turn off the
# planner rather than the product. With the Builder on, a person can still author a
# complete Watchlist with every AI part switched off.
SETUP_FREE_TEXT_ENABLED=true
SETUP_PLANNER_ENABLED=true
SETUP_COMPOSER_ENABLED=true
SETUP_BUILDER_ENABLED=true
SETUP_SCANNER_ENABLED=true
SETUP_MONITOR_ENABLED=true
# Both are lists, so "empty" is an empty JSON list. Written as a bare `=`, pydantic tries
# to read "" as JSON and startup fails with a parse error that names neither the file nor
# the fix. `SETUP_CHAT_PRIVATE_BETA_USER_IDS=[]` is the same shape, done correctly.
SETUP_BUILDER_USER_IDS=[]
SETUP_AI_LANGUAGES=[]
SETUP_TURN_DEADLINE_SECONDS=45.0
SETUP_PREFLIGHT_SYMBOL_CAP=25
SETUP_PREFLIGHT_MAX_CONCURRENCY=4
# Crash recovery for a turn that died holding its session. Off means a crashed turn
# locks the session and the person cannot send anything.
SETUP_CHAT_RECOVERY_DISABLED=false
SETUP_CHAT_RECOVERY_INTERVAL_SECONDS=60
# Forbidden in staging and production; startup refuses it. A permanently optional
# question identity lets a message written against a screen that has moved on land on
# whatever field is current now.
SETUP_CHAT_ALLOW_MISSING_ANSWER_IDENTITY=false

# --- Runtime rollout ceilings -------------------------------------------------
# Hard ceilings a runtime control can never switch back on. Comma separated.
AI_FEATURES_DISABLED=
BUILDER_CAPABILITIES_DISABLED=
AI_ROLLOUT_VERSION=0

# --- AI money ceilings --------------------------------------------------------
# Enforced by one authority. A call whose cost cannot be estimated is refused.
AI_BUDGET_PER_TURN_MAX_USD=1.0
AI_BUDGET_USER_DAILY_USD=5.0
AI_BUDGET_USER_MONTHLY_USD=50.0
AI_BUDGET_GLOBAL_DAILY_USD=200.0
AI_BUDGET_GLOBAL_MONTHLY_USD=2000.0
AI_BUDGET_MAX_CONCURRENT_RESERVATIONS=3

# --- Provider reliability -----------------------------------------------------
# Every bound is finite on purpose: an unbounded pool opens a socket per concurrent
# call, and an unbounded wait hangs every caller instead of failing reportably.
PROVIDER_POOL_MAX_CONNECTIONS=40
PROVIDER_POOL_MAX_KEEPALIVE=20
PROVIDER_POOL_KEEPALIVE_SECONDS=30.0
PROVIDER_POOL_TIMEOUT_SECONDS=5.0
PROVIDER_CONNECT_TIMEOUT_SECONDS=5.0
PROVIDER_READ_TIMEOUT_SECONDS=30.0
PROVIDER_WRITE_TIMEOUT_SECONDS=10.0
PROVIDER_MAX_CONCURRENCY=24
PROVIDER_RETRY_MAX_ATTEMPTS=3
PROVIDER_RETRY_BASE_DELAY_SECONDS=0.5
PROVIDER_RETRY_MAX_DELAY_SECONDS=8.0
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_RECOVERY_SECONDS=30.0
PROVIDER_CIRCUIT_SHARE_STATE=true

# --- Capability expression bounds ---------------------------------------------
CAPABILITY_EXTENSION_MAX_EXPRESSION_DEPTH=6
CAPABILITY_EXTENSION_MAX_EXPRESSION_NODES=120

# --- Shariah source discovery -------------------------------------------------
# Finding an authority's own pages, rather than trusting a link somebody typed.
# The provider decides which search API is asked; "none" switches discovery off and
# leaves the layered resolver reading only links already registered.
SHARIA_SOURCE_SEARCH_ENABLED=true
SHARIA_SOURCE_SEARCH_PROVIDER=google
SHARIA_SOURCE_SEARCH_RESULTS=10
SHARIA_SOURCE_LINKS_PER_CATEGORY=3
# How much recent, on-topic publishing a page must show before the product stops
# looking for more links to go with it. A page below this is kept and still counts as
# evidence; it simply no longer holds a category up on its own.
SHARIA_SOURCE_ACTIVITY_FLOOR=0.45

# Reading a page with a real browser, for the ones a plain request cannot read. More and
# more project blogs and forums only exist after JavaScript has run, and a plain fetch
# sees an empty shell and calls the page unreadable.
# ON by default. The Docker image now installs Chromium; for a local checkout run:
#   python -m playwright install chromium
# The server has 3.9 GB and no swap, so what a browser may spend is bounded rather than
# trusted: one browser per sweep, one page open at a time, images and GPU off, and the
# page budget below. See services/sharia_page_render.py.
SHARIA_SOURCE_BROWSER_RENDER_ENABLED=true
SHARIA_SOURCE_BROWSER_RENDER_TIMEOUT_SECONDS=25
SHARIA_SOURCE_BROWSER_RENDER_MAX_CHARACTERS=2000000
# How many pages one sweep may draw with a browser before it stops and says so. A sweep is
# 25 coins and only the addresses a plain fetch could not read ever reach the browser, so
# this is generous for normal running and a stop for when something has gone wrong.
SHARIA_SOURCE_BROWSER_RENDER_MAX_PAGES=40
# The last layer, and the only paid one. A model is asked where a coin publishes ONLY
# when every free layer has run for that coin and a required category still has no
# working link at all. What it returns is filtered and proved exactly like a search
# result, so an invented address can never become evidence.
SHARIA_SOURCE_AI_DISCOVERY_ENABLED=false
SHARIA_SOURCE_AI_MODEL=gpt-5.6-luna
SHARIA_SOURCE_AI_REASONING_EFFORT=none
SHARIA_SOURCE_AI_TIMEOUT_SECONDS=45
SHARIA_SOURCE_AI_MAX_OUTPUT_TOKENS=900
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
BRAVE_SEARCH_API_KEY=

# --- Test-only. Startup refuses this in staging and production. ---------------
# With it set, every sign-in code and every System Brain second factor is the value
# written here.
AUTH_TEST_FIXED_CODE=

# --- CoinMarketCap ---------------------------------------------------------
# Provider record for coin identity: official website, whitepaper, explorers,
# source code, logo, and market ranking. Used by the coin researcher as a
# provider-grade discovery layer, and never as a Shariah authority.
COINMARKETCAP_API_BASE=https://pro-api.coinmarketcap.com
COINMARKETCAP_API_KEY=your-coinmarketcap-api-key
COINMARKETCAP_PLAN=basic
COINMARKETCAP_ENABLED=true

# How long a provider answer is reused. Coin metadata changes rarely; market numbers
# change constantly, so the two have separate lifetimes.
COINMARKETCAP_METADATA_CACHE_HOURS=168
COINMARKETCAP_QUOTE_CACHE_SECONDS=300
COINMARKETCAP_TIMEOUT_SECONDS=20
# Coins carried by one provider call. 100 is the documented maximum, and it is what
# makes a sweep over the whole unscreened universe cost single-figure credits.
COINMARKETCAP_BATCH_SIZE=100

# --- Unscreened coin research ----------------------------------------------
# Gathers the website, whitepaper and repository for coins that are tradeable on
# Binance or Bybit but carry no Shariah result. Writes no Shariah status of any kind.
UNSCREENED_RESEARCH_ENABLED=true
UNSCREENED_RESEARCH_BATCH_LIMIT=300
UNSCREENED_RESEARCH_INTERVAL_HOURS=24

# --- The automated screen ---------------------------------------------------
# Reads the pages of coins the researcher gathered links for, and records what the
# Hilal Markets Methodology makes of them. It publishes nothing: every result is a
# proposal marked as reviewed by nobody.
#
# The batch is small on purpose. Research is one provider call per hundred coins;
# this fetches up to twelve web pages per coin, so 25 coins is a few hundred page
# reads — a polite amount to ask of other people's servers in one run.
AUTOMATED_SCREEN_BATCH_LIMIT=25
AUTOMATED_SCREEN_INTERVAL_HOURS=24

# How often size, rank and 7/30/90-day movement are re-read for screened coins.
# Two provider calls for the whole list, once a day.
MARKET_NUMBERS_INTERVAL_HOURS=24
