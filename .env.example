ALTERNATIVE_ME_ENABLED=false
FRED_API_BASE=https://api.stlouisfed.org/fred
FRED_API_KEY=
FRED_ENABLED=false
TELEGRAM_ENABLED=false
TELEGRAM_ADAPTER=none
# Official Meta WhatsApp Cloud API. Keep disabled until the Meta business,
# phone number, webhook, token, and any required templates are configured.
WHATSAPP_ENABLED=false
WHATSAPP_ADAPTER=none
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_BUSINESS_PHONE_E164=
WHATSAPP_DEFAULT_LANGUAGE=en_US
WHATSAPP_HTTP_TIMEOUT_SECONDS=15
WHATSAPP_MAX_DELIVERY_ATTEMPTS=5
WHATSAPP_OPPORTUNITY_ALERTS_ENABLED=false
# JSON map of Meta-approved template names. Required production keys:
# connection_confirmation, connection_test, account_notice, trial_update,
# subscription_update, compliance_change, evidence_update, watchlist_paused,
# integration_failure, lifecycle_update, and confirmed_research_event when
# opportunity alerts are enabled. See docs/WHATSAPP_CLOUD_API_RUNBOOK.md.
WHATSAPP_TEMPLATE_NAMES={}
WHATSAPP_OPT_IN_VERSION=2026-07
WHATSAPP_MARK_INBOUND_READ=true
WHATSAPP_WEBHOOK_RECEIPT_RETENTION_DAYS=30
# Set true only after the selected provider credentials, webhooks, and every
# required product mapping below have been configured and verified.
BILLING_ENABLED=false
# Select providers by payment method. The legacy BILLING_PROVIDER remains a
# local/backward-compatible fallback when these are disabled.
BILLING_PROVIDER=static
BILLING_CARD_PROVIDER=disabled
BILLING_CRYPTO_PROVIDER=disabled
BILLING_CHECKOUT_TTL_MINUTES=30
BILLING_TERMS_VERSION=2026-07
BILLING_PAYMENT_AMOUNT_TOLERANCE_PERCENT=0
BILLING_ALLOW_OVERPAYMENT=false
PAYMENT_EMAIL_MAX_ATTEMPTS=5
PAYMENT_EMAIL_RETRY_MINUTES=15
STRIPE_SECRET_KEY=
STRIPE_PRICE_IDS={}
STRIPE_API_BASE=https://api.stripe.com
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
# Required keys when Creem is enabled: trader_monthly, trader_annual,
# pro_monthly, and pro_annual. A trial is optional and remains unavailable
# until a separately verified Creem trial product is configured.
CREEM_PRODUCT_IDS={}
CREEM_API_BASE=https://test-api.creem.io
CREEM_TIMEOUT_SECONDS=20
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io
NOWPAY_EMAIL=
NOWPAY_PASSWORD=
# Application-wide abuse controls. Deployed environments fail closed when Redis
# cannot enforce these limits. Override the JSON only as one complete object.
API_RATE_LIMITING_ENABLED=true
API_RATE_LIMIT_FAIL_CLOSED=true
API_RATE_LIMITS={"authentication":{"limit":10,"window_seconds":900},"ai_chat":{"limit":30,"window_seconds":60},"market_check":{"limit":20,"window_seconds":60},"checkout":{"limit":5,"window_seconds":300},"portal":{"limit":10,"window_seconds":300},"support":{"limit":5,"window_seconds":3600},"passport_report":{"limit":5,"window_seconds":3600},"telegram_test":{"limit":5,"window_seconds":300},"whatsapp_test":{"limit":5,"window_seconds":300},"public_chat":{"limit":20,"window_seconds":60},"public_inquiry":{"limit":5,"window_seconds":3600},"public_waitlist":{"limit":5,"window_seconds":3600},"public_contact":{"limit":5,"window_seconds":3600},"admin_mutation":{"limit":30,"window_seconds":60}}
AI_INTERPRETER_PROVIDER=openai
# Server-side only. Used by AI Setup Chat and structured strategy interpretation.
OPENAI_API_KEY=
# Optional model override. The default is the project's low-cost structured-output model.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-nano
OPENAI_REASONING_EFFORT=low
# Test-process controls for the authenticated AI Setup Chat evaluator. Runtime
# validation rejects these in staging/production. Version labels map only to
# server-owned model/prompt variants; customers cannot supply model names.
AI_SETUP_EVALUATOR_ENABLED=false
AI_SETUP_EVALUATOR_FAULTS_ENABLED=false
AI_SETUP_EVALUATOR_TARGET_VERSIONS={}
# The authenticated Setup Chat path. There is no other writable route, so this stays
# true; startup validation rejects false.
SETUP_CHAT_LAUNCH_V2_ENABLED=true
# Test-only compatibility path. Staging and production reject true.
SETUP_CHAT_LEGACY_TEST_COMPAT_ENABLED=false

# --- Setup Agent bounds. These are the values that govern Setup Chat traffic. ---
# One planning call per turn, plus at most this many retries, and only for a transport
# failure. A schema or grounding failure is never retried.
SETUP_AGENT_PLANNER_MAX_OUTPUT_TOKENS=8000
SETUP_AGENT_COMPOSER_MAX_OUTPUT_TOKENS=1600
SETUP_AGENT_PLANNER_TIMEOUT_SECONDS=60
SETUP_AGENT_COMPOSER_TIMEOUT_SECONDS=10
SETUP_AGENT_SIMPLE_SERVICE_TIER=default
SETUP_AGENT_COMPLEX_SERVICE_TIER=default
SETUP_AGENT_MAX_ESTIMATED_COST_USD_PER_TURN=0.10
SETUP_AGENT_CIRCUIT_BREAKER_FAILURES=5
SETUP_AGENT_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
SETUP_PROVIDER_PREFLIGHT_TTL_SECONDS=300
SETUP_SCREENING_RESOLUTION_TTL_SECONDS=300
SETUP_METHODOLOGY_VERSION_TTL_SECONDS=300
SETUP_APPROVED_WATCHLIST_TTL_SECONDS=300
OPENAI_TIMEOUT_SECONDS=20
OPENAI_EXPLANATION_ENABLED=true
# Setup Chat routing changes model cost/latency only; it never changes tool or approval authority.
AI_SETUP_SIMPLE_MODEL=gpt-5.4-nano
AI_SETUP_SIMPLE_REASONING_EFFORT=low
AI_SETUP_COMPLEX_MODEL=gpt-5-mini
AI_SETUP_COMPLEX_REASONING_EFFORT=low
AI_SETUP_COMPLEX_CONDITION_THRESHOLD=4
AI_SETUP_REPEATED_CORRECTION_THRESHOLD=2
AI_SETUP_LOW_CAPABILITY_CONFIDENCE=0.72
# Bounded Agent Control is the OLD general coordinator. It has no authority over
# authenticated Setup Chat: that path is the Setup Agent above, and none of the
# AI_AGENT_* values below govern it. Retained for isolated experiments only, and off by
# default — turning it on does not change Setup Chat, and turning it off is not a Setup
# Chat rollback.
AI_AGENT_CONTROL_ENABLED=false
AI_AGENT_SHADOW_MODE=false
AI_AGENT_ROLLOUT_PERCENT=0
AI_AGENT_MAX_STEPS=4
AI_AGENT_MAX_TOOL_CALLS_PER_TURN=4
AI_AGENT_MAX_REPEATED_CALLS=1
AI_AGENT_TIMEOUT_SECONDS=45
AI_AGENT_TOOL_TIMEOUT_SECONDS=30
AI_AGENT_MAX_OUTPUT_TOKENS=1800
AI_AGENT_MAX_ESTIMATED_COST_USD_PER_TURN=0.02
AI_AGENT_PARALLEL_TOOL_CALLS=false

# Integrated evaluator CLI. Credentials remain local and must identify a
# dedicated authenticated test user. Full real API/UI runs are manual/scheduled.
TEST_AI_MODEL=gpt-5-mini
TEST_AI_REASONING=low
TEST_AI_SERVICE_TIER=flex
JUDGE_MAX_OUTPUT_TOKENS=4000
# Current gpt-5-mini Flex prices per 1M tokens. Recheck official API pricing
# when the evaluator model or service tier changes.
TEST_AI_INPUT_USD_PER_1M=0.125
TEST_AI_CACHED_INPUT_USD_PER_1M=0.0125
TEST_AI_OUTPUT_USD_PER_1M=1
EVAL_OUTPUT_DIR=chatbot_eval_runs
EVAL_CACHE_DB=.chatbot_eval_cache.sqlite3
EVAL_BUDGET_USD=2.5
# The budget profile clamps any larger CLI override to this all-in limit.
EVAL_BUDGET_PROFILE_MAX_USD=2.5
EVAL_MAX_CONCURRENCY=2
EVAL_DEFAULT_TESTS_PER_TOPIC=24
EVAL_READINESS_ATTEMPTS=2
EVAL_CIRCUIT_BREAKER_FAILURES=2
TARGET_STRATEGY_SCHEMA_FILE=tests/evaluator/contracts/strategy_definition.schema.json
TARGET_SCHEMA_FILE=tests/evaluator/contracts/setup_chat_evaluation_contract.schema.json
TARGET_FIELD_MAP_FILE=tests/evaluator/contracts/field_map.json
TARGET_BACKEND_ADAPTER=hilalmarkets
TARGET_BACKEND_BASE_URL=http://127.0.0.1:8000
TARGET_BACKEND_SESSION_PATH=/api/v1/dashboard/setup-chat/sessions
TARGET_BACKEND_MESSAGE_PATH_TEMPLATE=/api/v1/dashboard/setup-chat/sessions/{chat_id}/messages
TARGET_BACKEND_LOGIN_PATH=/signin
TARGET_BACKEND_EMAIL=
TARGET_BACKEND_PASSWORD=
# Optional short-lived session for scheduled black-box runs. Keep secret and
# prefer a dedicated evaluator account; this value is never written to reports.
TARGET_SESSION_COOKIE=
TARGET_UI_URL=http://127.0.0.1:8000/dashboard/strategies/new
TARGET_UI_EMAIL=
TARGET_UI_PASSWORD=
TARGET_UI_HEADLESS=true
TARGET_VARIANTS_JSON=[]
# Optional AI semantic fallback for unresolved prompt fragments.
# Disabled by default. Deterministic parser always runs first, and AI output
# is validated against the capability registry before any condition is created.
AI_SEMANTIC_FALLBACK_ENABLED=false
AI_SEMANTIC_FALLBACK_MODEL=gpt-5.4-nano
AI_SEMANTIC_FALLBACK_MIN_CONFIDENCE=0.85
AI_SEMANTIC_FALLBACK_REVIEW_CONFIDENCE=0.65
AI_SEMANTIC_FALLBACK_CACHE_TTL_SECONDS=86400
AI_SEMANTIC_FALLBACK_MAX_CALLS_PER_PROMPT=2
AI_SEMANTIC_FALLBACK_MAX_FRAGMENT_CHARS=160
# Hybrid shortlist reranking. AI can select only registry-provided immutable capability keys.
AI_CAPABILITY_RERANKER_ENABLED=true
AI_CAPABILITY_RERANKER_MIN_CONFIDENCE=0.86
AI_CAPABILITY_RERANKER_CANDIDATE_LIMIT=24
CAPABILITY_EMBEDDINGS_ENABLED=true
CAPABILITY_EMBEDDING_MODEL=text-embedding-3-small
CAPABILITY_EMBEDDING_DIMENSIONS=256
# Certified non-existing mechanics use a constrained JSON AST, never generated Python.
CAPABILITY_EXTENSION_ENABLED=true
CAPABILITY_EXTENSION_DRAFT_MODEL=gpt-5.4-nano
CAPABILITY_EXTENSION_DRAFT_REASONING_EFFORT=low
CAPABILITY_EXTENSION_IMPLEMENTATION_MODEL=gpt-5.4-nano
CAPABILITY_EXTENSION_REVIEW_MODEL=gpt-5.4-mini
CAPABILITY_EXTENSION_REPAIR_SERVICE_TIER=flex
CAPABILITY_EXTENSION_AI_MAX_ATTEMPTS=3
CAPABILITY_EXTENSION_FLEX_TIMEOUT_SECONDS=900
CAPABILITY_EXTENSION_PREFLIGHT_EXCHANGE=binance
CAPABILITY_EXTENSION_PREFLIGHT_MAX_SYMBOLS=200
CAPABILITY_EXTENSION_PREFLIGHT_CONCURRENCY=8
CAPABILITY_EXTENSION_CANDLE_LIMIT=500
CAPABILITY_EXTENSION_MAX_HISTORY_CANDLES=25000
CAPABILITY_EXTENSION_MARKET_TEST_CANDLE_BUDGET=300000
CAPABILITY_EXTENSION_EMPTY_SCAN_THRESHOLD=5
CAPABILITY_EXTENSION_NO_NOTIFICATION_THRESHOLD=5
CAPABILITY_EXTENSION_MIN_CANDIDATE_RATE=0.0005
CAPABILITY_EXTENSION_MAX_CANDIDATE_RATE=0.35
CAPABILITY_EXTENSION_CERTIFICATION_SCORE=85
CAPABILITY_EXTENSION_DAILY_LIMIT=3
# Optional enrichment endpoint. POST JSON:
# {"exchange":"binance","symbols":["BTC/USDT"]}
# Response: {"symbols":{"BTC/USDT":{"category":"layer-1","market_cap":123}}}
MARKET_METADATA_API_URL=
MARKET_METADATA_API_KEY=
MARKET_METADATA_TIMEOUT_SECONDS=15
UNIVERSE_METADATA_CONCURRENCY=8
ON_DEMAND_SCAN_CONCURRENCY=8
# Optional condition-context providers. Bybit spot data is read from BYBIT_* above,
# not from these CRYPTO_INDEX/TOKEN_CATEGORY placeholders. Leave these blank in the
# spot-only beta unless you add a real global-index/category provider and tests.
# Each endpoint receives a POST body containing category, requested_keys, exchange,
# symbol, timeframe, quote_assets and evaluated_at. It must return
# {"values":{"condition_key":true_or_number},"as_of":"ISO-8601"}.
CRYPTO_INDEX_API_URL=
CRYPTO_INDEX_API_KEY=
MACRO_MARKET_API_URL=
MACRO_MARKET_API_KEY=
EVENT_FEED_API_URL=
EVENT_FEED_API_KEY=
TOKEN_CATEGORY_API_URL=
TOKEN_CATEGORY_API_KEY=
# Derivatives are disabled for the spot-only product. Keep these empty.
DERIVATIVES_CONTEXT_API_URL=
DERIVATIVES_CONTEXT_API_KEY=
CONTEXT_PROVIDER_TIMEOUT_SECONDS=15
CONTEXT_FETCH_CONCURRENCY=8
MARKET_BREADTH_MAX_SYMBOLS=100
SUPPORT_EMAIL=contact@trace-edge.com
SUPPORT_TELEGRAM_USERNAME=
ADMIN_NOTIFY_TELEGRAM_USER_ID=
