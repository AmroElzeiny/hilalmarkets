# Test AI: one model plays the adaptive trader and the evidence judge.
OPENAI_API_KEY=
TEST_AI_MODEL=gpt-5-mini
TEST_AI_REASONING=low
TEST_AI_SERVICE_TIER=flex
TEST_AI_BASE_URL=https://api.openai.com/v1
TEST_AI_TIMEOUT_SECONDS=120
TEST_AI_MAX_OUTPUT_TOKENS=1200
TEST_AI_INPUT_USD_PER_1M=0
TEST_AI_CACHED_INPUT_USD_PER_1M=0
TEST_AI_OUTPUT_USD_PER_1M=0

# Optional separate judge settings. Empty values inherit TEST_AI_*.
JUDGE_MODEL=
JUDGE_REASONING=low
JUDGE_SERVICE_TIER=flex
JUDGE_MAX_OUTPUT_TOKENS=1600

# Run controls. Full mode defaults to 24 cases/topic; accepted range is 20..30.
EVAL_OUTPUT_DIR=chatbot_eval_runs
EVAL_CACHE_DB=.chatbot_eval_cache.sqlite3
EVAL_BUDGET_USD=25
EVAL_MAX_CONCURRENCY=2
EVAL_DEFAULT_TESTS_PER_TOPIC=24
EVAL_DEFAULT_MAX_TURNS=8
EVAL_REDACT_KEYS=password,token,secret,api_key,authorization,cookie,set-cookie

# Target selection: backend, ui, or both.
TARGET_MODE=backend
TARGET_NAME=HilalMarkets AI Setup Chat
TARGET_VERSION_LABEL=current
TARGET_SCHEMA_FILE=
# Map canonical oracle fields to paths in the compiled target object.
# Example only: {"symbol":"universe.symbols.0","timeframe":"entry.timeframe"}
TARGET_FIELD_MAP_JSON={}

# Backend adapter for the AI Setup Chat, not the public support widget.
TARGET_BACKEND_URL=http://127.0.0.1:8000/api/watchlists/ai-chat
TARGET_BACKEND_METHOD=POST
TARGET_BACKEND_HEALTH_URL=http://127.0.0.1:8000/health
TARGET_BACKEND_RESET_URL=
TARGET_BACKEND_AUTH_HEADER=Authorization
TARGET_BACKEND_AUTH_TOKEN=
TARGET_BACKEND_HEADERS_JSON={}
# Request template supports {{message}}, {{conversation_id}}, {{history_json}}, {{scenario_id}}, {{fault}}.
TARGET_BACKEND_REQUEST_TEMPLATE_JSON={"message":"{{message}}","conversation_id":"{{conversation_id}}"}
TARGET_BACKEND_RESPONSE_TEXT_PATH=message
TARGET_BACKEND_RESPONSE_OBJECT_PATH=compiled_strategy
TARGET_BACKEND_CONVERSATION_ID_PATH=conversation_id
TARGET_BACKEND_MODEL_PATH=model
TARGET_BACKEND_USAGE_PATH=usage
TARGET_BACKEND_TIMEOUT_SECONDS=90
# Test-only header consumed by a non-production fault-injection adapter after Codex integration.
TARGET_FAULT_HEADER=X-HM-Eval-Fault
TARGET_INPUT_USD_PER_1M=0
TARGET_CACHED_INPUT_USD_PER_1M=0
TARGET_OUTPUT_USD_PER_1M=0

# UI adapter. URL must point to authenticated AI Setup Chat / Watchlist Builder.
TARGET_UI_URL=http://127.0.0.1:8000/dashboard/watchlists/new
TARGET_UI_LOGIN_URL=http://127.0.0.1:8000/signin
TARGET_UI_EMAIL=
TARGET_UI_PASSWORD=
TARGET_UI_STORAGE_STATE=
TARGET_UI_HEADLESS=true
TARGET_UI_EXPECTED_MARKER=AI Setup Chat
TARGET_UI_FORBIDDEN_MARKERS=support agent,customer support,help widget
TARGET_UI_EMAIL_SELECTOR=input[type=email]
TARGET_UI_PASSWORD_SELECTOR=input[type=password]
TARGET_UI_LOGIN_SUBMIT_SELECTOR=button[type=submit]
TARGET_UI_INPUT_SELECTOR=[data-testid=ai-setup-input],textarea,[contenteditable=true]
TARGET_UI_SEND_SELECTOR=[data-testid=ai-setup-send],button[type=submit]
TARGET_UI_ASSISTANT_MESSAGE_SELECTOR=[data-role=assistant],[data-message-author-role=assistant],.assistant-message
TARGET_UI_NEW_CHAT_SELECTOR=[data-testid=new-ai-setup-chat]
TARGET_UI_CHAT_API_PATTERN=*/api/*chat*
TARGET_UI_RESPONSE_OBJECT_PATH=compiled_strategy
TARGET_UI_TIMEOUT_MS=90000
TARGET_UI_SCREENSHOTS=true

# Optional target variants for drift testing. Headers and payload_overrides are merged per variant.
# Example: [{"name":"old","headers":{"X-Eval-Model":"gpt-old"}},{"name":"new","headers":{"X-Eval-Model":"gpt-new"}}]
TARGET_VARIANTS_JSON=[]
