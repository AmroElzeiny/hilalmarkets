+#: Every provider event type that reaches `_upsert_subscription` for a subscription
+#: that already exists, with the status word that provider sends with it. Each one
+#: maps to ACTIVE or TRIALING — each one is therefore a way to make an ended row live
+#: again. `subscription.paid` is included so the family is asserted whole, not just
+#: the payment half of it that the original guard covered.
+RESURRECTION_EVENTS: list[tuple[str, str]] = [
+    ("subscription.paid", "active"),
+    ("subscription.updated", "active"),
+    ("subscription.update", "active"),
+    ("customer.subscription.updated", "active"),
+    ("subscription.scheduled_cancel", "scheduled_cancel"),
+    ("subscription.trialing", "trialing"),
+]
+
+
+@pytest.mark.parametrize(("event_type", "provider_status"), RESURRECTION_EVENTS)
+async def test_a_late_event_of_any_type_cannot_resurrect_an_ended_subscription(
+    test_context, monkeypatch, event_type: str, provider_status: str
+) -> None:
+    """No event shape may set a CANCELED/EXPIRED row back to ACTIVE/TRIALING.
+
+    The guard used to fire only for paid event types. But Creem also sends
+    ``subscription.updated``, ``subscription.update``, ``customer.subscription.updated``
+    and ``subscription.scheduled_cancel`` — all of which map to ACTIVE — and
+    ``subscription.trialing``, which maps to TRIALING. Any of them arriving after our
+    cancel made the ended row live again: two paid plans charging, the exact outcome
+    the paid-event guard exists to prevent. A real re-subscribe gets a new provider
+    subscription id, so refusing these loses nothing legitimate.
+    """
+
+    slug = event_type.replace(".", "-")
+    email = f"resurrect-{slug}@example.com"
+    await _signup(test_context, email)
+    user, old, source = await _seed_old_payment(
+        test_context, email=email, plan_code="trader"
+    )
+    enabled = test_context["settings"].model_copy(update=live_billing_overrides())
+    attempt = await _prepare_new_checkout(
+        test_context, user=user, target_code="pro", settings=enabled
+    )
+
+    async def successful_cancel(*args, **kwargs):
+        return httpx.Response(200, request=httpx.Request("POST", str(args[2])))
+
+    monkeypatch.setattr(replacement_module, "provider_request", successful_cancel)
+    async with test_context["session_factory"]() as session:
+        moved = await BillingService(
+            session, enabled, provider_name="creem"
+        ).process_event(
+            provider="creem",
+            payload=_paid_event(
+                attempt=attempt, target_code="pro", event_id=f"move-paid-{slug}"
+            ),
+        )
+        await session.commit()
+    assert moved.processing_status == "processed"
+
+    now = datetime.now(UTC)
+    late_event_id = f"late-{slug}"
+    late_payload = {
+        "id": late_event_id,
+        "type": event_type,
+        "data": {
+            "checkout_attempt_id": str(source.id),
+            "plan_code": "trader",
+            "provider_subscription_id": old.provider_subscription_id,
+            "amount": str(source.amount),
+            "currency": source.currency,
+            "status": provider_status,
+            "current_period_start": now.isoformat(),
+            "current_period_end": (now + timedelta(days=30)).isoformat(),
+        },
+    }
+    async with test_context["session_factory"]() as session:
+        with pytest.raises(BillingError) as error:
+            await BillingService(
+                session, enabled, provider_name="creem"
+            ).process_event(provider="creem", payload=late_payload)
+        assert error.value.code == "subscription_resurrected_after_cancel"
+
+    async with test_context["session_factory"]() as session:
+        old_after = await session.get(Subscription, old.id)
+        assert old_after is not None
+        assert old_after.status == SubscriptionStatus.CANCELED
+        live = list(
+            (
+                await session.scalars(
+                    select(Subscription).where(
+                        Subscription.user_id == user.id,
+                        Subscription.status.in_(
+                            [SubscriptionStatus.ACTIVE, SubscriptionStatus.TRIALING]
+                        ),
+                    )
+                )
+            ).all()
+        )
+        assert [row.provider_subscription_id for row in live] == [
+            f"new-creem-{attempt.id}"
+        ]
+        event = await session.scalar(
+            select(BillingEvent).where(BillingEvent.provider_event_id == late_event_id)
+        )
+        assert event is not None
+        assert event.processing_status == "failed"
+        assert event.error_code == "subscription_resurrected_after_cancel"
+        resurrection_notices = [
+            row
+            for row in (await session.scalars(select(OperationalIssue))).all()
+            if row.dedupe_key.startswith("billing:subscription-resurrected:")
+        ]
+        assert [row.dedupe_key for row in resurrection_notices] == [
+            f"billing:subscription-resurrected:{late_event_id}"
+        ]
+        assert resurrection_notices[0].severity == "critical"
+        assert resurrection_notices[0].state == "open"
