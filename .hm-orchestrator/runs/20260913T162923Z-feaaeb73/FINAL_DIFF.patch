+            "current_period_end": (now + timedelta(days=30)).isoformat(),
+            "cancel_at_period_end": True,
+            "settlement_expected_amount": str(attempt.amount),
+            "settlement_actual_amount": str(attempt.amount),
+            "settlement_currency": attempt.currency,
